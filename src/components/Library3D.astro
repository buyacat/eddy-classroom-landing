---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';
import ModelViewer from './ModelViewer.astro';
import LibGlyph from './LibGlyph.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;

// `model` is a src/data/models.json id; a card without one has no model yet.
const cards = tArray<{
  subject: string;
  label: string;
  name: string;
  glyph?: string;
  model?: string;
}>(locale, 'classroom_library_cards');

// Subjects are contiguous in `cards`, so slicing at each subject's start index yields exact, non-overlapping pages.
const SUBJECT_ORDER = ['biology', 'chemistry', 'physics', 'geography'] as const;
const starts = SUBJECT_ORDER
  .map((subject) => cards.findIndex((c) => c.subject === subject))
  .filter((start) => start !== -1);
const groups = starts.map((start, i) => ({
  items: cards.slice(start, starts[i + 1] ?? cards.length),
  label: cards[start].label
}));

// Viewport width is sized to the busiest subject (physics=4) so no cell bleeds onto the next page.
const widest = Math.max(...groups.map((g) => g.items.length), 1);

const subjectBlock: Record<string, string> = {
  biology: 'is-green',
  physics: 'is-blue',
  chemistry: 'is-yellow',
  geography: 'is-ink'
};
---

<section class="band lib" id="library">
  <div class="wrap">
    <div class="lib-top">
      <div class="lib-head-l reveal">
        <span class="eyebrow">{t(locale, 'classroom_library_badge')}</span>
        <p class="lib-count">
          <span class="stat-num" data-countup>{t(locale, 'classroom_library_count')}</span>
          <span class="lib-count-lbl">{t(locale, 'classroom_library_count_label')}</span>
        </p>
        <p class="lib-desc">{t(locale, 'classroom_library_desc')}</p>
      </div>

      <nav class="lib-comb reveal" style={`--i:1; --comb-count:${widest}`}
           aria-label={t(locale, 'classroom_library_badge')}>
      <div class="lib-comb-row">
        <button class="lib-comb-arrow" type="button" data-comb-prev aria-label={t(locale, 'classroom_library_prev')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>

        <div class="lib-comb-viewport">
          <div class="lib-comb-track" data-comb-track>
          {groups.map((g) => (
            <ul class="lib-comb-page">
            {g.items.map((c) => (
              <li>
              <button class={`hex ${subjectBlock[c.subject] || 'is-blue'}`} type="button"
                      data-name={c.name} data-label={c.label} data-model={c.model}>
                <span class="hex-shadow">
                  <span class="hex-face">
                    <span class="hex-art">
                  {c.glyph === 'eye' ? (
                    /* check-icons: glass-ok — wet corneal gloss, not polished clay */
                    <svg class="hex-obj hex-eye" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                      <defs>
                        <radialGradient id="eyeball" cx="33%" cy="25%" r="85%">
                          <stop offset="0" stop-color="#FFFFFF" />
                          <stop offset=".34" stop-color="#F6F8FF" />
                          <stop offset=".66" stop-color="#E1E6F8" />
                          <stop offset=".86" stop-color="#BCC5E7" />
                          <stop offset="1" stop-color="#8C97C9" />
                        </radialGradient>
                        <radialGradient id="eye-bounce" cx="76%" cy="79%" r="31%">
                          <stop offset="0" stop-color="#F2F6FF" stop-opacity=".9" />
                          <stop offset="1" stop-color="#F2F6FF" stop-opacity="0" />
                        </radialGradient>
                        <radialGradient id="eye-iris" cx="34%" cy="27%" r="80%">
                          <stop offset="0" stop-color="#9CA8FF" />
                          <stop offset=".34" stop-color="#5B6BFF" />
                          <stop offset=".72" stop-color="#2E3ADF" />
                          <stop offset="1" stop-color="#141A8C" />
                        </radialGradient>
                        <radialGradient id="eye-pupil" cx="38%" cy="32%" r="78%">
                          <stop offset="0" stop-color="#2B3152" />
                          <stop offset=".5" stop-color="#121627" />
                          <stop offset="1" stop-color="#04060E" />
                        </radialGradient>
                        <linearGradient id="eye-lid" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0" stop-color="#4C5798" stop-opacity=".34" />
                          <stop offset="1" stop-color="#4C5798" stop-opacity="0" />
                        </linearGradient>
                        <filter id="eye-b6" x="-50%" y="-50%" width="200%" height="200%">
                          <feGaussianBlur stdDeviation="6" />
                        </filter>
                        <filter id="eye-b3" x="-50%" y="-50%" width="200%" height="200%">
                          <feGaussianBlur stdDeviation="3" />
                        </filter>
                        <clipPath id="eye-clip"><circle cx="128" cy="130" r="96" /></clipPath>
                      </defs>

                      <circle cx="128" cy="130" r="96" fill="url(#eyeball)" />
                      <circle cx="128" cy="130" r="96" fill="url(#eye-bounce)" />

                      <g clip-path="url(#eye-clip)">
                        {/* upper-lid shadow: what stops the ball reading as a flat disc */}
                        <rect x="-10" y="18" width="280" height="62" fill="url(#eye-lid)" filter="url(#eye-b6)" />

                        <g class="eye-gaze">
                          <ellipse cx="104" cy="134" rx="43" ry="49" fill="url(#eye-iris)" />
                          <ellipse cx="104" cy="134" rx="43" ry="49" fill="none"
                                   stroke="#0F187A" stroke-opacity=".45" stroke-width="4" />
                          <ellipse class="eye-pupil" cx="104" cy="134" rx="18" ry="21" fill="url(#eye-pupil)" />
                        </g>

                        {/* cornea: a faint rise plus the wet rim below it */}
                        <ellipse cx="104" cy="132" rx="56" ry="62" fill="#FFFFFF" opacity=".07" />
                        <path d="M58 158 Q104 206 152 156" fill="none" stroke="#FFFFFF" stroke-opacity=".4"
                              stroke-width="8" stroke-linecap="round" filter="url(#eye-b3)" />
                      </g>

                      <ellipse cx="82" cy="98" rx="21" ry="14" fill="#FFFFFF" opacity=".95" transform="rotate(-32 82 98)" />
                      <ellipse cx="64" cy="122" rx="8" ry="6" fill="#FFFFFF" opacity=".6" transform="rotate(-32 64 122)" />
                      <ellipse cx="152" cy="180" rx="14" ry="8" fill="#FFFFFF" opacity=".3"
                               filter="url(#eye-b3)" transform="rotate(-20 152 180)" />
                    </svg>
                  ) : c.glyph ? (
                    <img class={`hex-obj ic-${c.glyph}`}
                         src={withBase(`/assets/icons/lib/${c.glyph}.png`)}
                         width="256" height="256" alt="" loading="lazy" decoding="async" />
                  ) : (
                    <LibGlyph id={c.model ?? ''} />
                  )}

                  {c.glyph === 'crust' && (
                    <svg class="hex-fx fx-seam" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                      <path d="M107 118.6 L145.3 76.8" />
                    </svg>
                  )}
                  {c.glyph === 'volcano' && (
                    <svg class="hex-lava" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
                      <g transform="translate(126 58) rotate(-31)"><ellipse class="gob g1" rx="15" ry="18" /></g>
                      <g transform="translate(126 58) rotate(-14)"><ellipse class="gob g2" rx="19" ry="23" /></g>
                      <g transform="translate(126 58) rotate(2)"><ellipse class="gob g3" rx="13" ry="16" /></g>
                      <g transform="translate(126 58) rotate(17)"><ellipse class="gob g4" rx="18" ry="21" /></g>
                      <g transform="translate(126 58) rotate(33)"><ellipse class="gob g5" rx="12" ry="15" /></g>
                    </svg>
                  )}
                </span>
                  </span>
                </span>
                <span class="nm">{c.name}</span>
              </button>
              </li>
            ))}
            </ul>
          ))}
          </div>
        </div>

        <button class="lib-comb-arrow" type="button" data-comb-next aria-label={t(locale, 'classroom_library_next')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>

      <div class="lib-comb-dots" role="tablist">
        {groups.map((g, gi) => (
          <button class="lib-comb-dot" type="button" data-comb-dot={gi} role="tab" aria-label={g.label}>
            <span class="dot"></span>
            <span class="dot-lbl">{g.label}</span>
          </button>
        ))}
      </div>
      </nav>
    </div>

    <ModelViewer locale={locale} />
  </div>
</section>

<style>
  .lib::before {
    background:
      radial-gradient(calc(var(--amb-r-lg) * 1.25) calc(var(--amb-r-lg) * .62) at 10% 24%,
        rgba(var(--amb-yellow), var(--amb-3)) 0%,
        rgba(var(--amb-yellow), calc(var(--amb-3) * .4)) 38%,
        rgba(var(--amb-yellow), 0) 72%),
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .5) at 66% 76%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) var(--amb-fade));
  }

  /* the platform band's last row of cards and this strip are one reading beat apart:
     a full band gap here read as the page ending, so the top padding is trimmed */
  .lib { padding-top: calc(var(--pad-band) * .6); }

  /* title and strip share a row; description gets its own full-width line below */
  .lib-top {
    display: grid;
    /* auto (not 1fr) keeps the strip its own compact width instead of stretching to fill the row */
    grid-template-columns: auto auto;
    justify-content: space-between;
    align-items: end; /* aligns strip bottom with the description's last line */
    gap: clamp(20px, 3vw, 44px);
    margin-bottom: clamp(16px, 2.2vw, 28px);
  }
  .lib-head-l { flex: none; }

  .lib-count { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-top: 12px; }
  .lib-count .stat-num { font-size: clamp(3.25rem, 2rem + 5.2vw, 6rem); line-height: .9; color: var(--blue); }
  .lib-count-lbl {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.625rem, 1.1rem + 1.8vw, 2.75rem);
    letter-spacing: -.03em; color: var(--ink);
  }
  .lib-desc {
    margin-top: clamp(16px, 2vw, 24px);
    font-size: 1.0625rem; line-height: 1.55; color: var(--ink-2); max-width: 60ch;
  }

  /* strip is paged by subject: each subject is a full-viewport-width page, track slides one page per click */
  .lib-comb {
    --hex-w: 64px;
    --hex-h: calc(var(--hex-w) * 1.1547);
    --hex-cell: calc(var(--hex-w) + 22px);
    /* --comb-count is set from the frontmatter data (busiest subject) so no page can spill onto the next */
    --comb-count: 3;
    /* + 4px for the page's own side padding, which is inside this width */
    --comb-w: calc(var(--comb-count) * var(--hex-cell) + (var(--comb-count) - 1) * 8px + 4px);
    min-width: 0;
  }
  .lib-comb-row { display: flex; align-items: center; gap: 18px; }
  .lib-comb-viewport { flex: none; width: var(--comb-w); overflow: hidden; }
  .lib-comb-track {
    display: flex;
    transition: transform 380ms var(--ease-spring, ease);
  }
  .lib-comb-page {
    flex: 0 0 100%;
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 4px 2px;
    list-style: none;
    min-width: 0;
  }
  .lib-comb-page li { flex: none; }

  .lib-comb-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-sunken);
    color: var(--ink-2);
    cursor: pointer;
    transition: background 160ms linear, color 160ms linear, opacity 160ms linear;
  }
  .lib-comb-arrow svg { width: 18px; height: 18px; }
  .lib-comb-arrow:hover { background: var(--line); color: var(--ink); }
  .lib-comb-arrow:disabled { opacity: .35; cursor: default; background: var(--surface-sunken); color: var(--ink-2); }

  /* one dot per subject, its name underneath so the dot is a destination
     rather than an abstract page marker */
  .lib-comb-dots {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 3vw, 32px);
    margin-top: 8px;
  }
  .lib-comb-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    border: 0;
    background: none;
    padding: 4px;
    cursor: pointer;
  }
  .lib-comb-dot .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
    transition: background 160ms linear, transform 160ms var(--ease-spring);
  }
  .lib-comb-dot .dot-lbl {
    font-family: var(--font-display);
    font-size: .6875rem;
    font-weight: 700;
    color: var(--ink-3);
    transition: color 160ms linear;
  }
  .lib-comb-dot:hover .dot { background: var(--ink-3); }
  .lib-comb-dot.is-active .dot { background: var(--ink); transform: scale(1.3); }
  .lib-comb-dot.is-active .dot-lbl { color: var(--ink); font-weight: 800; }

  .hex {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: var(--hex-cell, calc(var(--hex-w) + 24px));
    border: 0;
    border-radius: var(--r-lg);
    background: none;
    padding: 6px 4px;
    cursor: pointer;
    --glyph-t: 880ms;
    --glyph-e: cubic-bezier(.42, 0, .22, 1);
    transform: translateY(0);
    transition: transform 260ms var(--ease-spring), background 160ms linear;
  }
  .hex:hover { z-index: 3; background: var(--surface-sunken); transform: translateY(-3px); }
  /* a picked cell stays lit whether or not the pointer is still on it */
  .hex.is-active { z-index: 2; background: var(--surface-sunken); transform: translateY(-3px); }
  .hex.is-active:hover { transform: translateY(-4px); }

  /* unmasked, so its drop-shadow filter isn't clipped by .hex-face's mask */
  .hex-shadow {
    display: block;
    width: var(--hex-w);
    height: var(--hex-h);
    filter: drop-shadow(0 4px 8px rgba(15, 18, 45, .14));
    transition: filter 220ms var(--ease-out);
  }
  .hex:hover .hex-shadow { filter: drop-shadow(0 14px 22px rgba(15, 18, 45, .24)); }
  .hex.is-active .hex-shadow { filter: drop-shadow(0 12px 20px rgba(15, 18, 45, .22)); }
  .hex.is-active:hover .hex-shadow { filter: drop-shadow(0 16px 24px rgba(15, 18, 45, .28)); }

  .hex-face {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    -webkit-mask-image: var(--hex-mask);
    mask-image: var(--hex-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .hex.is-green .hex-face { background: var(--green); }
  .hex.is-blue .hex-face { background: var(--blue); }
  .hex.is-yellow .hex-face { background: var(--yellow); }
  .hex.is-ink .hex-face { background: var(--ink-block); }

  .hex-art {
    position: relative;
    display: block;
    width: 32px;
    perspective: 500px;
  }
  .hex-obj {
    display: block;
    width: 100%;
    height: auto;
  }

  /* per-asset scale correction: each clay render had different empty canvas around it at source */
  .hex-obj.ic-crust { transform: scale(1.02); }
  .hex-obj.ic-volcano { transform: scale(1.02); }
  .hex-eye { transform: scale(1.13); }

  /* specular highlight stays fixed (on the cornea, not the iris) — if it moved with the pupil it'd read as a sticker */
  .hex-eye .eye-pupil { transform-box: fill-box; transform-origin: 50% 50%; }
  .hex:hover .hex-eye .eye-gaze  { animation: eye-gaze calc(var(--glyph-t) * 1.7) cubic-bezier(.5, 0, .15, 1); }
  .hex:hover .hex-eye .eye-pupil { animation: eye-dilate calc(var(--glyph-t) * 1.7) ease-in-out; }
  @keyframes eye-gaze {
    0%, 6%    { transform: translate(0, 0); }
    24%, 34%  { transform: translate(-15px, 5px); }
    56%, 66%  { transform: translate(17px, -4px); }
    88%, 100% { transform: translate(0, 0); }
  }
  @keyframes eye-dilate {
    0%, 100% { transform: scale(1); }
    28%      { transform: scale(1.45); }
    64%      { transform: scale(.84); }
  }

  .hex-lava, .hex-fx {
    position: absolute; inset: 0; width: 100%; height: 100%;
    overflow: visible; pointer-events: none;
  }
  .hex-lava .gob { fill: #FF8E22; opacity: 0; filter: drop-shadow(0 0 6px rgba(255, 150, 40, .85)); }
  .hex:hover .hex-lava .gob { animation: lava-throw var(--glyph-t) cubic-bezier(.25, .6, .35, 1); }
  .hex-lava .g1 { --h: -60px; fill: #FFA83C; animation-delay: 40ms; }
  .hex-lava .g2 { --h: -84px; animation-delay: 0ms; }
  .hex-lava .g3 { --h: -94px; fill: #FFC24E; animation-delay: 70ms; }
  .hex-lava .g4 { --h: -80px; animation-delay: 25ms; }
  .hex-lava .g5 { --h: -56px; fill: #FF7A16; animation-delay: 90ms; }
  @keyframes lava-throw {
    0%   { transform: translateY(8px) scale(.3); opacity: 0; }
    16%  { transform: translateY(-8px) scale(1); opacity: 1; }
    64%  { opacity: .9; }
    100% { transform: translateY(var(--h, -70px)) scale(.5); opacity: 0; }
  }

  .fx-seam path {
    fill: none; stroke: #FFA53A; stroke-width: 15; stroke-linecap: round; opacity: 0;
    filter: drop-shadow(0 0 7px rgba(255, 140, 40, .95));
  }
  .hex:hover .fx-seam path { animation: fx-flare var(--glyph-t) ease-out; }
  @keyframes fx-flare { 0%, 100% { opacity: 0; } 22% { opacity: .95; } 58% { opacity: .35; } 76% { opacity: .9; } }
  .hex:hover .fx-seam { animation: fx-shudder 480ms ease-in-out; }
  @keyframes fx-shudder {
    0%, 100% { transform: translate(0, 0); }
    22% { transform: translate(1.6px, -1px); }
    46% { transform: translate(-1.6px, 1px); }
    72% { transform: translate(1px, .6px); }
  }

  .hex .nm {
    max-width: calc(var(--hex-w) + 20px);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: .6875rem;
    line-height: 1.25;
    color: var(--ink-2);
    text-align: center;
  }
  .hex:hover .nm, .hex.is-active .nm { color: var(--ink); }

  /* browsers differ on whether a click counts as "visible focus"; drop the outline on :focus and draw our own on :focus-visible (keyboard only) */
  .hex:focus, .lib-comb-arrow:focus, .lib-comb-dot:focus { outline: none; }
  .hex:focus-visible, .lib-comb-arrow:focus-visible, .lib-comb-dot:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--r-lg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hex { transition: none; }
    .hex:hover .hex-lava .gob,
    .hex:hover .hex-eye .eye-gaze, .hex:hover .hex-eye .eye-pupil,
    .hex:hover .hex-fx, .hex:hover .hex-fx path { animation: none; }
  }

  /* 900px breakpoint: strip's fixed width (4 cells ~86px + gaps ≈ 372px) plus headline column + gutter needs ~900px; below that it wraps */
  @media (max-width: 900px) {
    .lib-top { grid-template-columns: 1fr; gap: 16px; justify-items: center; }
    .lib-head-l { justify-self: stretch; }
    .lib-comb-row { justify-content: center; }
    .lib-count .stat-num { font-size: clamp(2.25rem, 1.4rem + 5vw, 3rem); } /* smaller stacked so it doesn't overpower the nav below */
  }

  /* Below 560px arrows move into the pager row (dots carry subject names and read better on a phone; strip also swipes, see script).
     Hex width: page holds 4 cells + 3×6px gaps inside a 16px gutter; cell = hexagon + 22px label gutter -> hexagon = 25vw - 39px
     (extra slack vs. the derived 34.5px accounts for a narrowed desktop window, where 100vw includes an unused scrollbar). */
  @media (max-width: 560px) {
    .lib-comb {
      --hex-w: clamp(40px, calc(25vw - 39px), 64px);
      --comb-w: 100%;
      width: 100%;
      /* display:contents lets one DOM order serve both layouts — arrows sit beside dots here, beside the strip on desktop */
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "strip strip strip"
        "prev  dots  next";
      align-items: center;
      column-gap: 6px;
    }
    .lib-comb-row { display: contents; }
    .lib-comb-viewport { grid-area: strip; flex: none; width: 100%; min-width: 0; }
    .lib-comb-arrow[data-comb-prev] { grid-area: prev; }
    .lib-comb-arrow[data-comb-next] { grid-area: next; }
    .lib-comb-arrow { width: 32px; height: 32px; }
    .lib-comb-arrow svg { width: 17px; height: 17px; }
    .lib-comb-page { flex-wrap: nowrap; gap: 6px; padding: 4px 2px; }
    .hex { padding: 5px 3px; }
    .hex .nm { font-size: .625rem; }
    .lib-comb-dots {
      grid-area: dots;
      gap: clamp(2px, 2.4vw, 26px);
      margin-top: 12px;
      min-width: 0;
    }
    .lib-comb-dot { padding: 6px 2px; min-width: 0; }
    .lib-comb-dot .dot-lbl {
      font-size: clamp(.625rem, 2.9vw, .75rem);
      white-space: nowrap;
    }
    /* arrows align to the dots' optical baseline (dot-over-word sits higher than row center), not the row's own center */
    .lib-comb-arrow { align-self: center; margin-top: 12px; }
  }
</style>

<script>
  // click a cell -> dispatch mv:select with model/name/label/icon; the panel decides what to render (incl. "no model yet")
  const cells = document.querySelectorAll<HTMLButtonElement>('.hex');
  const panel = document.querySelector<HTMLElement>('.mv');

  /* The panel sits a screen below the strip. A pick that leaves the viewer
     out of view reads as "nothing happened", so the page rolls down to it —
     unless most of it is already on screen (then a scroll would only jitter). */
  function revealPanel() {
    if (!panel) return;
    const r = panel.getBoundingClientRect();
    const seen = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
    if (seen >= Math.min(r.height, window.innerHeight) * .7) return;
    panel.scrollIntoView({
      block: 'start',
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
    });
  }

  function pickCell(btn: HTMLButtonElement) {
    cells.forEach((b) => b.classList.toggle('is-active', b === btn));
    panel?.dispatchEvent(new CustomEvent('mv:select', {
      detail: {
        model: btn.dataset.model,
        name: btn.dataset.name,
        label: btn.dataset.label,
        icon: btn.querySelector<HTMLImageElement>('.hex-obj')?.src
      }
    }));
    revealPanel();
  }

  if (panel && cells.length) {
    cells.forEach((btn) => btn.addEventListener('click', () => pickCell(btn)));

    // the panel opens on its first model; the matching cell is lit from the start
    try {
      const firstId = (JSON.parse(panel.dataset.models || '[]') as { id: string }[])[0]?.id;
      cells.forEach((b) => b.classList.toggle('is-active', !!firstId && b.dataset.model === firstId));
    } catch { /* no models: nothing to light */ }
  }

  const track = document.querySelector<HTMLElement>('[data-comb-track]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-comb-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-comb-next]');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-comb-dot]'));

  if (track && dots.length) {
    const pageCount = track.children.length;
    let page = 0;

    function render() {
      track!.style.transform = `translateX(-${page * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('is-active', i === page));
      if (prevBtn) prevBtn.disabled = page === 0;
      if (nextBtn) nextBtn.disabled = page === pageCount - 1;
    }

    function goTo(next: number) {
      page = Math.min(pageCount - 1, Math.max(0, next));
      render();
    }

    /* A subject is a destination, not a page marker: picking one opens that
       subject's first model in the panel and rolls down to it. */
    dots.forEach((d, i) => d.addEventListener('click', () => {
      goTo(i);
      const lead = (track!.children[i] as HTMLElement | undefined)?.querySelector<HTMLButtonElement>('.hex');
      if (lead) pickCell(lead);
    }));
    prevBtn?.addEventListener('click', () => goTo(page - 1));
    nextBtn?.addEventListener('click', () => goTo(page + 1));

    // track is transform-driven (not a native scroller), so swipe is manual: 42px horizontal drag pages; a mostly-vertical drag is left alone so page scroll isn't eaten
    let x0 = 0;
    let y0 = 0;
    let axis: '' | 'x' | 'y' = '';

    track.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      x0 = t.clientX;
      y0 = t.clientY;
      axis = '';
    }, { passive: true });

    track.addEventListener('touchmove', (e) => {
      if (axis) return;
      const t = e.touches[0];
      const dx = Math.abs(t.clientX - x0);
      const dy = Math.abs(t.clientY - y0);
      if (dx > 10 || dy > 10) axis = dx > dy ? 'x' : 'y';
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      if (axis !== 'x') return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 42) goTo(page + (dx < 0 ? 1 : -1));
    }, { passive: true });

    render();
  }
</script>
