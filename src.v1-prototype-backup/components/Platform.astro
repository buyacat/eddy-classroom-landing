---
const items = [
  {
    emoji: '🖥️',
    title: 'Вебверсія для вчителя й адміністратора',
    text: 'Підготовка курсів і занять, робота з бібліотекою, конструктор тестів і вікторин із різними типами запитань, перегляд результатів і журналу сесій.',
    wide: true
  },
  {
    emoji: '📱',
    title: 'Зручний учнівський доступ',
    text: 'Після приєднання до потрібного курсу учень легко переглядає його матеріали, виконує завдання та проходить тестування.'
  },
  {
    emoji: '🖼️',
    title: 'Інтерактивна панель і Whiteboard',
    text: 'Фронтальна демонстрація презентацій, відео, документів, 3D-моделей і симуляцій на весь клас; можливість малювати й робити позначки просто поверх матеріалу в реальному часі.'
  },
  {
    emoji: '📊',
    title: 'Аналітика й дашборд ефективності уроку',
    text: 'Наочний огляд залученості класу та засвоєння матеріалу з рекомендаціями для вчителя на основі результатів сесій.'
  },
  {
    emoji: '🎲',
    title: 'Ігрові інструменти уроку',
    text: 'Колесо фортуни для випадкового вибору учня, таймер і шумомір — прості інструменти, які додають уроку динаміки.'
  },
  {
    emoji: '💻',
    title: 'Віртуальний клас',
    text: 'Підключення учнів до заняття дистанційно: перегляд матеріалів і спілкування навіть поза межами класу.'
  },
  {
    emoji: '🎓',
    title: 'Безкоштовний курс підвищення кваліфікації',
    text: 'Онлайн-курс для вчителів з роботи на платформі із сертифікатом про проходження.',
    accent: true
  }
];
---
<section class="platform band" id="platform">
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow center">Платформа</span>
      <h2>Що входить у платформу <span>Eddy Classroom</span></h2>
    </div>
    <div class="plat-grid">
      {items.map((it) => (
        <div class={`plat-card reveal${it.wide ? ' wide' : ''}${it.accent ? ' accent' : ''}`}>
          <div class="emoji-tile">{it.emoji}</div>
          <div>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
