const svg = glyphs[name] ?? glyphs.cell;
---

<svg class={`glyph ${cls}`} viewBox="0 0 96 96" role="presentation"
     aria-hidden="true" focusable="false" set:html={svg} />

<style>
  /* Sized here, not by the parent: an Astro scoped rule in Library3D can
     not reach into this component, so the old `.hex-obj` width never
     applied and every glyph rendered at its intrinsic 96px. */
  .glyph {
    display: block;
    /* 20% down from the 96px the SVG used to render at */
    width: 47%;
    max-width: 77px;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, .26));
    transition: transform 420ms cubic-bezier(.34, 1.4, .5, 1);
  }
  @media (max-width: 700px) {
    .glyph { max-width: 58px; }
  }
</style>
