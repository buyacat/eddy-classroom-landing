    ${seat}
    <path d="M87.9,69.6 A16.0,16.0 0 0 1 86.7,74.3 L81.0,73.5 A10.5,10.5 0 0 1 78.9,75.9 L80.7,81.4 A16.0,16.0 0 0 1 76.3,83.4 L73.3,78.4 A10.5,10.5 0 0 1 70.1,78.3 L66.9,83.2 A16.0,16.0 0 0 1 62.6,81.0 L64.7,75.5 A10.5,10.5 0 0 1 62.8,73.0 L57.0,73.5 A16.0,16.0 0 0 1 56.0,68.7 L61.5,67.0 A10.5,10.5 0 0 1 62.3,63.9 L58.3,59.7 A16.0,16.0 0 0 1 61.5,56.0 L66.3,59.2 A10.5,10.5 0 0 1 69.2,57.9 L70.0,52.1 A16.0,16.0 0 0 1 74.8,52.3 L75.3,58.0 A10.5,10.5 0 0 1 78.2,59.5 L83.1,56.5 A16.0,16.0 0 0 1 86.1,60.4 L81.9,64.4 A10.5,10.5 0 0 1 82.5,67.5 Z" fill="url(#g-gr-b)"/>
