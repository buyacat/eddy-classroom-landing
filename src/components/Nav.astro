---
import { t, altPath } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props { locale: Locale }
const { locale } = Astro.props;

/* The Eddy Group header, rebuilt from eddygroup.eu: full-width white bar,
   group wordmark on the left, the group menu centred in uppercase, the
   language switch on the right. The old in-page section menu
   (#why / #platform / #library) is gone — this page is a landing, so the
   header's job is moving between Eddy sites, not inside this one.

   Menu targets and the #1F2C2E link ink are taken verbatim from the live
   eddygroup.eu header so the bar reads as the same navigation everywhere. */
const links = [
  { href: 'https://trade.eddygroup.eu/', label: 'Trade' },
  { href: 'https://1vision.eddygroup.eu/', label: '1-Vision' },
  { href: 'https://drstem.eu/', label: 'Dr. STEM' },
  { href: 'https://svitlo.eddygroup.eu/', label: 'Svitlo' },
  {
    href: locale === 'uk' ? 'https://eddygroup.eu/news/' : 'https://eddygroup.eu/en/news/',
    label: t(locale, 'nav_news')
  },
  {
    href: locale === 'uk' ? 'https://eddygroup.eu/contact/' : 'https://eddygroup.eu/en/contact/',
    label: t(locale, 'nav_contacts')
  }
];
const alt = altPath(locale);
---

<header class="gnav" id="nav">
  <div class="gnav-bar">
   <div class="gnav-inner">
    <!-- Group wordmark, hairline, product wordmark — the same lockup the
         1-Vision site carries, so a visitor arriving from any Eddy property
         reads the same sentence: the company, then which of its products
         this is. The two halves are separate links because they are separate
         destinations: the group mark leaves for eddygroup.eu, the product
         mark returns to the top of this page. -->
    <div class="gnav-brand">
      <a href="https://eddygroup.eu/" class="gnav-group" target="_blank" rel="noopener">
        <img class="gnav-eddy" src={withBase('/assets/brand/eddy-black.svg')}
             alt="Eddy Group" width="158" height="26" />
      </a>
      <span class="gnav-vline" aria-hidden="true"></span>
      <a href="#top" class="gnav-product">
        <img class="gnav-mark" src={withBase('/assets/brand/classroom-mark.png')}
             alt="Eddy Classroom" width="127" height="26" />
      </a>
    </div>

    <nav class="gnav-links" aria-label="Eddy Group">
      {links.map((l) => (
        <a href={l.href} class="gnav-link" target="_blank" rel="noopener">{l.label}</a>
      ))}
    </nav>

    <div class="gnav-actions">
      <a href={alt} class="gnav-lang" aria-label={t(locale, 'nav_lang_aria')}>{t(locale, 'nav_lang_label')}</a>
      <button class="gnav-burger" id="nav-burger" type="button"
              aria-label={t(locale, 'nav_menu_open')} data-label-close={t(locale, 'nav_menu_close')}
              aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
     </div>
   </div>
  </div>

  <!-- The stack: three sheet edges fanned out under the bar at rest, closing
       into one 3px tri-colour line the moment the header sticks. -->
  <div class="gnav-stack" aria-hidden="true">
    <span class="sheet sheet-y"></span>
    <span class="sheet sheet-g"></span>
    <span class="sheet sheet-b"></span>
  </div>
</header>

<!-- The mobile menu is a full-screen sheet, not a dropdown card.
     Six destinations at finger size do not fit in a 300px panel hanging off
     the bar, and the old one proved it: a cramped list of 14px uppercase rows
     with no hierarchy, no way back to this page's own goal, and a hamburger
     that folded into a chevron instead of an X.

     The pattern is the one a marketing site with a flat, wide menu should
     use (UXPin / Webstacks / DesignStudio all land in the same place): take
     the whole screen, set the links large enough to be the page, and put the
     things a thumb actually reaches — the CTA and the language switch — at
     the BOTTOM, inside the natural thumb zone. The header bar stays visible
     above the sheet so the brand and the close control never move. -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true"
     aria-label={t(locale, 'nav_menu_open')}>
  <div class="mm-scroll">
    <span class="mm-kicker">{t(locale, 'nav_menu_sites')}</span>

    <nav class="mm-nav" aria-label="Eddy Group">
      {links.map((l, i) => (
        <a href={l.href} class="mm-link" style={`--i:${i}`} target="_blank" rel="noopener">
          <span class="mm-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="mm-label">{l.label}</span>
          <svg class="mm-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12h13M12.5 6l6 6-6 6" fill="none" stroke="currentColor"
                  stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
    </nav>

    <!-- The foot is the part a thumb can reach without moving the phone, so
         it carries the one action this page wants and the language switch —
         the two controls that were previously buried at the end of a list of
         six outbound links. -->
    <div class="mm-foot" style={`--i:${links.length}`}>
      <a href="#demo" class="btn btn-primary mm-cta">{t(locale, 'classroom_hero_cta_primary')}</a>

      <div class="mm-row">
        <span class="mm-row-lbl">{t(locale, 'nav_menu_lang')}</span>
        <a href={alt} class="mm-lang" aria-label={t(locale, 'nav_lang_aria')}>
          <b>{locale === 'uk' ? 'UA' : 'EN'}</b>
          <i aria-hidden="true"></i>
          <span>{t(locale, 'nav_lang_label')}</span>
        </a>
      </div>

      <div class="mm-contacts">
        <a href={`mailto:${t(locale, 'footer_email')}`}>{t(locale, 'footer_email')}</a>
        <a href={`tel:${t(locale, 'footer_phone').replace(/[^+\d]/g, '')}`}>{t(locale, 'footer_phone')}</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ---------- the header is a stack of exercise books ----------
     At the top of the page three coloured sheet edges are fanned out under
     the white bar, each one further back in real 3D space. As soon as the
     page scrolls the stack closes: the sheets drop to Z=0 and clip into
     three equal segments of a single 3px line, and the bar itself plays a
     short "settle" tilt, the way a stack lands on a desk. */
  .gnav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    perspective: 900px;
    /* vanishing point on the stack line, so receding sheets shrink toward
       it instead of drifting up the bar */
    perspective-origin: 50% 100%;
    transition: filter 200ms var(--ease-out);
  }
  .gnav-bar {
    background: #fff;
    transition: box-shadow 220ms var(--ease-out);
  }
  .gnav.is-stuck .gnav-bar { box-shadow: 0 4px 10px rgba(0, 0, 0, .05); }

  /* The bar itself never moves. It used to play a short rotateX "settle" on
     every is-stuck toggle, and that was a mistake three times over: the
     keyframe restarted each time the threshold was crossed, so slow scrolling
     around it rattled; the bar's text rendered through a 3D transform for the
     whole animation; and on a 1440px bar a few degrees of rotateX reads as
     the header coming loose, not as depth. The choreography lives entirely in
     the sheets below, where there is no type to distort. */

  .gnav-stack {
    position: absolute;
    inset: 100% 0 auto;
    height: 26px;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .sheet {
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    border-radius: 0 0 3px 3px;
    clip-path: inset(0 0 0 0);
    will-change: transform, clip-path;
    /* order matters: the per-state rules below address these four by index */
    transition:
      transform 1050ms var(--ease-glide),
      clip-path 850ms var(--ease-glide),
      opacity 380ms var(--ease-out),
      height 650ms var(--ease-glide);
  }
  /* Fanned at rest: a stepped block of three sheet edges. scaleX sets the
     step so it stays predictable at every viewport width; the small
     translateZ keeps the layers genuinely apart in 3D, which is what makes
     the settle tilt read as depth rather than as a slide. */
  .sheet-y { background: var(--yellow); z-index: 3; }
  .sheet-g {
    background: var(--green);
    z-index: 2;
    transform: translate3d(0, 6px, -22px) scaleX(.964);
    transition-delay: 60ms;
  }
  .sheet-b {
    background: var(--blue);
    z-index: 1;
    transform: translate3d(0, 12px, -46px) scaleX(.928);
    transition-delay: 120ms;
  }

  /* Closed until the page is ready, so the stack visibly fans open on load
     — the transition above does the work, no extra keyframes. */
  html:not(.is-loaded) .sheet { transform: none; }

  /* Closing: the stack shuts. All three sheets rise out of the fan into one
     row on the same long glide, staggered back to front, and each clips to
     its own third — so the line the reader lives with still carries the full
     brand chord instead of going one or two colours. Nothing springs: every
     move here is one the eye follows the whole way, and an overshoot reads
     as a twitch. The hero's coloured light drains on the same beat
     (Hero.astro, `html.nav-stuck`), so header and hero read as one system. */
  .gnav.is-stuck .sheet { height: 5px; }
  .gnav.is-stuck .sheet-y {
    clip-path: inset(0 66.67% 0 0);
    transition-delay: 0ms, 300ms, 0ms, 260ms;
  }
  .gnav.is-stuck .sheet-g {
    transform: translate3d(0, 0, 0);
    clip-path: inset(0 33.34% 0 33.33%);
    transition-delay: 110ms, 340ms, 0ms, 260ms;
  }
  .gnav.is-stuck .sheet-b {
    transform: translate3d(0, 0, 0);
    clip-path: inset(0 0 0 66.66%);
    transition-delay: 220ms, 380ms, 0ms, 260ms;
  }

  .gnav-inner {
    height: var(--nav-h);
    /* eddygroup.eu runs the bar to a 70px gutter, not to a centred column */
    padding-inline: clamp(16px, 4.6vw, 70px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 20px;
  }

  .gnav-brand { display: flex; align-items: center; gap: 13px; min-width: 0; }
  /* min-width on the brand alone was not enough: its two children are flex
     items carrying images, and a flex item's floor is its content size
     unless it is told otherwise — so the lockup kept its full width, spilled
     out of its column and lay on top of the burger. Playwright caught it
     before a thumb did: the click on #nav-burger was intercepted by
     .gnav-brand. */
  .gnav-group, .gnav-product { display: flex; min-width: 0; }
  .gnav-group img, .gnav-product img { object-fit: contain; object-position: left center; }
  /* The group mark is the taller of the two on purpose: it is the constant,
     and the product name reads as its subordinate rather than its twin. */
  .gnav-eddy { height: 26px; width: auto; display: block; }
  /* The product mark is set a touch taller than the group mark because its
     canvas carries the three-spark burst above the cap line: at an equal
     height the word itself would read smaller than "Eddy" beside it. */
  .gnav-mark { height: 26px; width: auto; display: block; }
  .gnav-vline { width: 1px; height: 24px; background: rgba(31, 44, 46, .22); }

  .gnav-links { display: flex; justify-content: center; }
  .gnav-link {
    padding: 4px 15px;
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .9375rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #1f2c2e;
    transition: color var(--t-micro) var(--ease-out);
  }
  .gnav-link:hover { color: var(--blue); }

  /* flex: none — the actions column is the one that must never be squeezed:
     it holds the only two controls in the bar. */
  .gnav-actions { display: flex; flex: none; align-items: center; justify-content: flex-end; gap: 8px; }

  .gnav-lang {
    display: grid; place-items: center;
    min-width: 44px; height: 36px;
    padding-inline: 12px;
    border-radius: var(--r-pill);
    border: 2px solid var(--line);
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .8125rem;
    letter-spacing: .04em;
    color: #1f2c2e;
    transition: border-color var(--t-micro) var(--ease-out), background-color var(--t-micro) var(--ease-out), color var(--t-micro) var(--ease-out);
  }
  .gnav-lang:hover { border-color: var(--ink); background: var(--ink); color: #fff; }

  /* The icon has to be measured, not guessed, or the open state is not an X.
     It was not: the button is a grid, `place-items` sets align-ITEMS and says
     nothing about align-CONTENT, so the three auto rows stretched to fill the
     36px button and the bars ended up 12px apart while the open state moved
     them 7. Two bars crossing 5px off centre draw a chevron — the ">" the
     screenshots kept showing where an X belonged.

     `place-content: center` stops the rows stretching and `gap` states the
     spacing outright, so the distance between two bar centres is a number
     this file owns (2px bar + 4px gap = 6px) instead of a number the button's
     height happens to produce. */
  .gnav-burger {
    display: none;
    width: 44px; height: 36px;
    border-radius: var(--r-pill);
    border: 2px solid var(--line);
    background: #fff;
    cursor: pointer;
    padding: 0;
    place-content: center;
    justify-items: center;
    gap: 4px;
  }
  .gnav-burger span {
    display: block;
    width: 18px; height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform var(--t-hover) var(--ease-out), opacity var(--t-micro) var(--ease-out);
  }
  .gnav-burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .gnav-burger.open span:nth-child(2) { opacity: 0; transform: scaleX(.2); }
  .gnav-burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .gnav-burger.open { border-color: var(--ink); }

  /* ---------- the mobile sheet ----------
     Full screen below the bar, not a floating card. dvh rather than vh:
     on mobile Safari 100vh is the height WITHOUT the address bar, which is
     exactly the strip a bottom-anchored CTA would be hidden behind. The
     sheet scrolls internally if a small phone needs it, and the body is
     locked while it is open (app.js), so the page behind never moves. */
  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0;
    z-index: 55;
    background: #fff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* the sheet wipes up from under the bar rather than fading in place —
       the same "a stack lands on a desk" gesture the header plays */
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 420ms var(--ease-glide),
      opacity 200ms var(--ease-out),
      visibility 0s linear 420ms;
  }
  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 460ms var(--ease-glide),
      opacity 160ms var(--ease-out),
      visibility 0s linear 0s;
  }

  .mm-scroll {
    height: 100%;
    /* The sheet is full-bleed but its CONTENTS are not: at the 1000px end of
       this breakpoint a full-width row left 700px of blank between "TRADE"
       and its arrow, which reads as a broken table rather than as a menu.
       A measure, centred — the same thing the page does with its own column. */
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 5vw, 28px) var(--gutter) calc(clamp(20px, 5vw, 32px) + env(safe-area-inset-bottom));
  }

  .mm-kicker {
    display: block;
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .6875rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .mm-nav { margin-top: 10px; }

  /* Each row is index / label / arrow. The index is what turns six equal
     outbound links into a list with a beginning and an end; the arrow says
     the link leaves this site, which every one of them does. */
  .mm-link {
    display: grid;
    grid-template-columns: 26px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 15px 2px;
    border-bottom: 1px solid var(--line);
    color: #1f2c2e;
  }
  .mm-idx {
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .6875rem;
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
    transition: color var(--t-micro) var(--ease-out);
  }
  .mm-label {
    font-family: var(--font-group);
    font-weight: 800;
    font-size: clamp(1.375rem, 1.1rem + 2.2vw, 1.875rem);
    line-height: 1.1;
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  .mm-arrow {
    width: 22px; height: 22px;
    color: var(--ink-4);
    transition: transform var(--t-hover) var(--ease-out), color var(--t-micro) var(--ease-out);
  }
  .mm-link:active .mm-label { color: var(--blue); }
  .mm-link:active .mm-arrow { color: var(--blue); transform: translateX(4px); }
  .mm-link:active .mm-idx { color: var(--blue); }

  /* ---- the foot: what a thumb can reach ---- */
  .mm-foot { margin-top: auto; padding-top: clamp(22px, 6vw, 34px); }
  .mm-cta { width: 100%; justify-content: center; }

  .mm-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
  }
  .mm-row-lbl {
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .6875rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  /* A switch that shows both sides, so it reads as a choice rather than as
     a two-letter link somebody left at the bottom of the list. The bold half
     is where you are; the plain half is where the tap goes. */
  .mm-lang {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border-radius: var(--r-pill);
    border: 2px solid var(--line);
    font-family: var(--font-group);
    font-size: .8125rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }
  .mm-lang b { font-weight: 800; color: #1f2c2e; }
  .mm-lang span { font-weight: 700; }
  .mm-lang i { width: 1px; height: 14px; background: var(--line); }
  .mm-lang:active { border-color: var(--ink); }

  .mm-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
  }
  .mm-contacts a {
    font-size: .875rem;
    font-weight: 700;
    color: var(--ink-3);
  }
  .mm-contacts a:active { color: var(--blue); }

  /* Rows arrive one after another once the wipe is under way — staggered off
     the row's own index, so the list reads top to bottom the way it is
     meant to be read. */
  .mobile-menu .mm-link,
  .mobile-menu .mm-foot { opacity: 0; transform: translateY(14px); }
  .mobile-menu.open .mm-link,
  .mobile-menu.open .mm-foot {
    opacity: 1;
    transform: none;
    transition:
      opacity 320ms var(--ease-out) calc(90ms + var(--i, 0) * 45ms),
      transform 380ms var(--ease-out) calc(90ms + var(--i, 0) * 45ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu .mm-link, .mobile-menu .mm-foot { transition: none; }
    .mobile-menu { clip-path: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet { transition: none; }
  }

  @media (max-width: 1180px) {
    /* a tablet on its side still shows the full menu, and 30px links are
       a mouse target, not a finger's — the bar has 68px, use it */
    .gnav-link { padding: 8px 10px; font-size: .875rem; }
    .gnav-lang { height: 40px; }
  }
  @media (max-width: 1000px) {
    .gnav-inner { grid-template-columns: minmax(0, 1fr) auto; }
    .gnav-links { display: none; }
    .gnav-burger { display: grid; }
    /* the sheet covers the page but never the bar: the brand stays put and
       the burger stays where the thumb last touched it, now as the close */
    .gnav { z-index: 60; }
    /* the two controls left in the bar are now tapped, not clicked —
       36px was under the 40px a thumb needs */
    .gnav-lang, .gnav-burger { height: 40px; }
  }
  @media (max-width: 620px) {
    .gnav-brand { gap: 10px; }
    .gnav-eddy { height: 21px; }
    .gnav-mark { height: 21px; }
    .gnav-vline { height: 19px; }
  }
  /* The lockup has to fit next to the two pills: at 360px that leaves
     216px for it, and the 21px/19px pair needs 248. Before this step the
     global `img { max-width: 100% }` did the fitting — by squeezing the
     group mark to 104px wide at a fixed 21px tall, i.e. squashing it. */
  @media (max-width: 430px) {
    .gnav-inner { gap: 12px; }
    .gnav-brand { gap: 8px; }
    .gnav-eddy { height: 18px; }
    .gnav-mark { height: 18px; }
    .gnav-vline { height: 16px; }
  }
  /* below 340px even that pair does not fit: the group mark is the
     constant, the product mark is what goes */
  @media (max-width: 340px) {
    .gnav-vline, .gnav-product { display: none; }
  }
</style>
