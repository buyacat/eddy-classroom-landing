/*
 * The honeycomb's eight objects, drawn rather than bought.
 *
 * The stock 3D set has an apple, a lightbulb, a flame and a map pin — four
 * objects for four subjects, which meant "Молекула ДНК" was a flame and
 * "Тектонічні плити" was the same pin as "Вулкан". Each cell now carries
 * the thing it actually names.
 *
 * They are drawn in the language of the bought objects — one solid form,
 * a top-lit vertical gradient, a white specular, a dark seat at the bottom
 * — so they sit next to the platform band's apple and medal without
 * looking like a different site. What they may NOT borrow is the palette:
 * every glyph is coloured against the tile it sits on (green, yellow, blue
 * or ink), so nothing here uses its own tile's colour. That is why the
 * cell is blue and the DNA is not yellow.
 *
 * viewBox is 96×96 for all eight; the CSS sizes them like the old <img>.
 */
interface Props { name: string; cls?: string }
const { name, cls = '' } = Astro.props;

/* Shared: `s` is the soft seat every object sits in, drawn first. */
const seat = `<ellipse cx="48" cy="86" rx="26" ry="5" fill="#000" opacity=".13"/>`;

