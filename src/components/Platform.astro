---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';
import WheelIcon from './WheelIcon.astro';
import PlatformMock from './PlatformMock.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;

const items = tArray<{ icon: string; title: string; text: string; shot_alt?: string; wide?: boolean }>(
  locale,
  'classroom_platform_items'
);

/*
 * This is the band that has to prove the feature list is real, so five of
 * the seven cards carry a window onto the product. Those windows used to
 * hold real captures of the shipping app; the captures had drifted out of
 * date (an old build's UI), so each one is now a drawn stand-in — see
 * PlatformMock.astro for why a sketch beats a stale screenshot.
 */
const shots: Record<string, { url: string }> = {
  web: { url: 'classroom.eddygroup.eu/library' },
  /* The one window that shows the product doing its whole job at once: the
     class answering on the right, the teacher's live table on the left. */
  session: { url: 'classroom.eddygroup.eu/session' },
  student: { url: 'classroom.eddygroup.eu/quiz' },
  panel: { url: 'classroom.eddygroup.eu/board' },
  analytics: { url: 'classroom.eddygroup.eu/results' }
};

/*
 * No hanging 3D object on these cards, and that absence is the design.
 *
 * The band used to carry seven of them at 96–128px — folder, apple, key,
 * pin, medal, gift, speech bubbles — on top of five browser windows, two
 * colour blocks, three tinted tool tiles and a roster panel. The client read
 * the result as crowded ("нагромадженість"), and the objects were the part
 * doing the crowding: each one is a saturated focal point competing with the
 * screenshot directly under it, and several of them (an apple for a group
 * test, a key for student access) were decorating rather than explaining.
 *
 * So the page now splits the two jobs between bands. WhyUs is the object
 * band: six claims, six objects, nothing else to look at. Platform is the
 * proof band: the product's own screens carry it, and the only icons left
 * are the three inside the games card, where they are the content and wear
 * their own labels.
 */

/* One colour block per row, on a diagonal: yellow top-left of the second
   row, blue bottom-right of the third. Blue is the product's own colour and
   it used to belong to the course card — the section keeps it on the card
   that shows a LIVE state. */
const blocks: Record<string, string> = {
  student: 'is-yellow',
  virtual: 'is-blue'
};

/* `games` and `virtual` have no shipping screen worth cropping, so instead
   of a crop they show a state of the product: the three in-lesson tools, and
   a roster with a LIVE chip — the same grammar as the hero's roster badge.
   That is why they are the two cards that still carry an image of their own
   after the band's decorative objects were dropped. */
const half = new Set(['games', 'virtual']);

/* The three in-lesson tools. Two of them used to be named by their reward
   instead of by themselves: a gold coin for the fortune wheel said "prize"
   when the point is the spin that picks a pupil, and a music note for the
   noise meter said "music" when the point is the noise. The wheel is drawn
   for this site (src/assets/icon-src/wheel.svg) because the pack has none;
   the megaphone is the pack's own object, and it is the one the client
   pointed at. The alarm clock was right the first time. */
const tools = [
  { key: 'wheel', title: t(locale, 'classroom_hero_wheel_title'), tint: 'is-yellow' },
  { key: 'clock', title: t(locale, 'classroom_hero_timer_title'), tint: 'is-blue' },
  { key: 'megaphone', title: t(locale, 'classroom_hero_noise_title'), tint: 'is-green' }
];

const roster = [
  { ini: 'АК', bg: 'var(--blue)', fg: '#fff' },
  { ini: 'МІ', bg: 'var(--yellow)', fg: '#000' },
  { ini: 'ОП', bg: 'var(--green)', fg: '#000' },
  { ini: 'ДС', bg: 'var(--ink)', fg: '#fff' }
];
---

<section class="band platform" id="platform">
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow">{t(locale, 'classroom_platform_eyebrow')}</span>
      <h2 set:html={t(locale, 'classroom_platform_title')} />
    </div>

    <div class="plat-grid">
      {items.map((it, i) => {
        const shot = shots[it.icon];
        const cls = [
          'card', 'plat-card', 'reveal',
          blocks[it.icon] || '',
          it.wide ? 'is-wide' : '',
          half.has(it.icon) ? 'is-half' : '',
          it.icon === 'analytics' ? 'is-analytics' : ''
        ].filter(Boolean).join(' ');
        return (
          <article class={cls} style={`--i:${i}`}>
            <div class="plat-body">
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>

            {shot && (
              <div class="plat-win">
                <span class="win-bar" aria-hidden="true">
                  <i class="d1"></i><i class="d2"></i><i class="d3"></i>
                  <span class="win-url">{shot.url}</span>
                </span>
                <span class="win-view">
                  <PlatformMock variant={it.icon as 'web' | 'session' | 'student' | 'panel' | 'analytics'} />
                </span>
              </div>
            )}

            {it.icon === 'games' && (
              <ul class="plat-tools" aria-label={it.title}>
                {tools.map((tool) => (
                  <li class={`plat-tool ${tool.tint} is-${tool.key}`}>
                    <span class="tool-ic" aria-hidden="true">
                      {tool.key === 'wheel'
                        ? <WheelIcon />
                        : <img class="obj is-inline" src={withBase(`/assets/icons/${tool.key}.png`)}
                               width="256" height="256" alt="" loading="lazy" decoding="async" />}
                      {tool.key === 'clock' && (
                        <>
                          <i class="buzz buzz-l"></i>
                          <i class="buzz buzz-r"></i>
                        </>
                      )}
                    </span>
                    <span>{tool.title}</span>
                  </li>
                ))}
              </ul>
            )}

            {it.icon === 'virtual' && (
              <div class="plat-roster" aria-hidden="true">
                <span class="avs">
                  {roster.map((r) => (
                    <span style={`background:${r.bg};color:${r.fg}`}>{r.ini}</span>
                  ))}
                </span>
                <span class="txt">
                  <span class="t1">{t(locale, 'classroom_hero_roster_class')}</span>
                  <span class="t2"><b>4</b> {t(locale, 'classroom_platform_virtual_remote')} · <b>22</b> {t(locale, 'classroom_platform_virtual_online')}</span>
                </span>
                <span class="shot-live"><i class="pulse"></i>{t(locale, 'classroom_hero_panel_live')}</span>
              </div>
            )}
          </article>
        );
      })}
    </div>

    {/* The phone pager. It exists only below 760px, where the grid turns into
        a swipe strip (see the media query) — above that it is display:none and
        the grid is a grid. One dot per card, labelled with the card's own
        title, so it is a list of destinations to a screen reader rather than
        seven anonymous circles. */}
    <div class="plat-dots" data-plat-dots>
      {items.map((it, i) => (
        <button class="plat-dot" type="button" data-plat-dot={i} aria-label={it.title}></button>
      ))}
    </div>
  </div>
</section>

<style>
  /* see WhyUs — the band is transparent so the ambient plane shows through */
  .platform::before {
    background:
      /* Blue is the product's own colour: the shot-bar dot, the library
         count, the CTA block. This is the band that has to prove the feature
         list is real, so this is the band lit in blue. */
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .58) at 98% 22%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) var(--amb-fade)),
      /* Yellow low and left, under the colour-block cards, so the grid's own
         yellow has somewhere to have come from. */
      radial-gradient(var(--amb-r-md) calc(var(--amb-r-md) * .62) at 2% 82%,
        rgba(var(--amb-yellow), var(--amb-2)) 0%,
        rgba(var(--amb-yellow), 0) var(--amb-fade)),
      /* A wide, weak green through the middle. The band is long and its
         centre column was the one stretch of bare canvas on the page; this
         fills it without putting a second colour event next to the blue. */
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .44) at 46% 56%,
        rgba(var(--amb-green), var(--amb-1)) 0%,
        rgba(var(--amb-green), 0) var(--amb-fade));
  }

  /* A wider gutter than the rest of the page uses. This band carries seven
     cards where WhyUs carries six, and five of them hold a second framed
     object inside — at the shared --gap-card the frames were only ~16px
     apart and the row read as one striped slab. The extra air is bought
     back by the ~64px of object overhang every card just lost, so the band
     is shorter than before, not longer. */
  .plat-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(18px, 1.8vw, 26px);
    /* no objects hang off these cards any more, so the grid no longer needs
       headroom for them — this is now just the gap under the band head */
    margin-top: clamp(40px, 3.6vw, 56px);
  }

  /* A `.card` (style.css) with the padding moved off the card and onto
     `.plat-body`, because the browser window below has to run edge to edge
     of the card. Surface, radius, hover lift, heading/body type and the
     colour-block variants all come from the shared rule. */
  .plat-card {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .plat-body { padding: clamp(26px, 2.4vw, 34px) var(--pad-card) clamp(20px, 1.9vw, 28px); }
  /* a one- and a two-line title in the same row must still align their
     body copy — Ukrainian card titles wrap unpredictably (same as WhyUs) */
  .plat-card:not(.is-wide) h3 { min-height: calc(2 * 1.22em); }

  /* Three tiers of card, and the type says which is which. With the objects
     gone the only thing left to rank the seven items is the text itself, so
     the two product screens lead at 26px, the two product states sit at the
     shared 22px, and the three supporting features drop to 19px with lighter
     body copy. Seven items at one size is the other way a grid reads as a
     pile. */
  .plat-card:not(.is-wide):not(.is-half) h3 { font-size: clamp(1.0625rem, 1rem + .3vw, 1.1875rem); }
  .plat-card:not(.is-wide):not(.is-half) p { font-size: .875rem; }

  /* the one blue card carries the page's only coloured shadow at rest */
  .plat-card.is-blue { box-shadow: var(--e-blue); }
  .plat-card.is-blue:hover { box-shadow: 0 18px 40px -14px rgba(64, 80, 255, .6); }

  /* ---- wide cards: the two that carry a full product screen ----
     They used to take a whole row each, which pushed the band past two
     viewport heights before the small cards even appeared. Paired at half
     width they read as one "here is the product" row, and the band lands
     in three rows: 2 screens / 3 features / 2 states. */
  .plat-card.is-wide { grid-column: span 3; }
  .plat-card.is-wide .plat-body { flex: none; }
  .plat-card.is-wide h3 { font-size: clamp(1.25rem, 1.05rem + .55vw, 1.625rem); }
  .plat-card.is-wide p { font-size: .9375rem; max-width: 46ch; }

  /* A browser window resting in the bottom of the card: chrome on top, the
     screen under it, and a real bottom edge — a window that ran off the
     card looked like a screenshot someone forgot to finish cropping. One
     viewport height for every window in the band, wide cards included, so
     five different screens read as five views of one product. */
  .plat-win {
    --win-inset: clamp(18px, 1.7vw, 28px);
    margin: auto var(--win-inset) var(--win-inset);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(15, 18, 45, .05), 0 20px 38px -20px rgba(15, 18, 45, .42);
    overflow: hidden;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #f1f2f7;
    border-bottom: 1px solid rgba(15, 18, 45, .07);
  }
  .win-bar i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .win-bar .d1 { background: #ff5f57; }
  .win-bar .d2 { background: #febc2e; }
  .win-bar .d3 { background: #28c840; }
  .win-url {
    flex: 1;
    min-width: 0;
    margin-left: 8px;
    height: 18px;
    padding: 0 9px;
    border-radius: var(--r-pill);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(15, 18, 45, .08);
    display: flex;
    align-items: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
  }
  /* A browser viewport is a wide letterbox, never a square. Height is set
     per card width so the ratio stays roughly 2:1 or wider — at 212px the
     narrow cards were showing a window shape no laptop has. */
  .win-view {
    display: block;
    height: 152px;
    overflow: hidden;
    background: #fff;
  }
  .plat-card.is-wide .win-view { height: clamp(172px, 14vw, 204px); }

  /* ---- half cards: the two that show a product state instead of a crop ---- */
  .plat-card.is-half { grid-column: span 3; }
  .plat-card.is-half .plat-body { flex: 1; }
  .plat-card.is-half p { max-width: 44ch; }

  /* three in-lesson tools, each on its own soft tint — a tile row, not a
     row of icons: the label is what makes it read as UI */
  .plat-tools {
    list-style: none;
    margin: 0;
    padding: 0 var(--pad-card) var(--pad-card);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .plat-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 8px 12px;
    border-radius: var(--r-md);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: .8125rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .plat-tool.is-yellow { background: var(--yellow-soft); }
  .plat-tool.is-blue { background: var(--blue-soft); }
  .plat-tool.is-green { background: var(--green-soft); }

  /* ---- the three tools wake up together, each answers on its own --------
     Hovering the card used to tilt all three objects at once with no other
     cue, which said "this is a picture on a card". It is not: it is three
     tools a teacher presses in a lesson. So the card hover now only lifts
     all three a touch — "these are pressable" — and the specific thing each
     tool does (the wheel spins and coasts to a stop, the timer trembles,
     the noise meter puts out sound) still only plays on the tile actually
     under the pointer. No tilt anywhere: an object doing its job does not
     lean. */
  .plat-tool {
    transition: transform var(--t-hover) var(--ease-out),
                box-shadow var(--t-hover) var(--ease-out);
  }
  .plat-tool:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(31, 44, 46, .09); }

  .plat-tool .tool-ic {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
  }
  .plat-tool .obj {
    width: 52px;
    height: 52px;
    /* the wheel is an inline <svg> now, so it needs the box stated twice */
    flex: none;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .14));
    transition: transform var(--t-card) var(--ease-spring);
  }
  /* the card-level hover lifts all three objects together — the shared
     "these are pressable" cue — while the specific animation below still
     only fires on the one tile actually under the pointer */
  .plat-card:hover .plat-tool .obj { transform: translateY(-3px); }

  /* wheel: the spin lives in WheelIcon.astro, because only the wedges turn
     and the flapper has to be knocked aside by them. Nothing here. */

  /* timer: an alarm clock that has just gone off — the body trembles and the
     two bells throw off buzz lines. The tremble is deliberately small and
     fast (2.5deg at 14Hz): any wider and it swings like a pendulum, which is
     a different object doing a different thing. */
  @keyframes tool-tremble {
    0%, 100% { transform: translate(0, -3px) rotate(0deg); }
    20%      { transform: translate(-.8px, -3px) rotate(-2.5deg); }
    40%      { transform: translate(.8px, -3.4px) rotate(2.5deg); }
    60%      { transform: translate(-.7px, -2.8px) rotate(-2deg); }
    80%      { transform: translate(.7px, -3.2px) rotate(1.8deg); }
  }
  /* two short rings with a beat of silence between them, like a real alarm
     catching its breath, rather than one continuous shake — each ring is
     4.5 cycles (~0.5s, 10% off the even half of the old single 10-cycle
     run), then ~0.15s still, then the second ring plays the same length */
  .plat-card .plat-tool.is-clock:hover .obj {
    animation: tool-tremble .11s linear 4.5,
               tool-tremble .11s linear 4.5 .65s;
  }

  /* the buzz lines sit off the bells, not off the middle of the clock: two
     arcs a side, the outer one a beat behind the inner one, so the sound
     reads as leaving the bell rather than as a halo around the icon */
  .plat-tool.is-clock .buzz {
    position: absolute;
    top: -5px;
    width: 15px;
    height: 15px;
    border: 2.5px solid transparent;
    border-top-color: var(--blue);
    border-radius: 50%;
    opacity: 0;
  }
  .plat-tool.is-clock .buzz::before {
    content: '';
    position: absolute;
    inset: 3.5px;
    border: 2.5px solid transparent;
    border-top-color: var(--blue);
    border-radius: 50%;
  }
  .plat-tool.is-clock .buzz-l { left: -7px; rotate: -48deg; }
  .plat-tool.is-clock .buzz-r { right: -7px; rotate: 48deg; }
  @keyframes tool-buzz {
    0%   { opacity: 0; scale: .7; }
    35%  { opacity: 1; scale: 1; }
    100% { opacity: 0; scale: 1.25; }
  }
  /* same two-ring shape as the tremble above: one buzz pair per ring,
     each pulse 10% shorter than before, the second pair timed to the
     second ring at .65s */
  .plat-tool.is-clock:hover .buzz-l {
    animation: tool-buzz .4s ease-out,
               tool-buzz .4s ease-out .65s;
  }
  .plat-tool.is-clock:hover .buzz-r {
    animation: tool-buzz .4s ease-out .2s,
               tool-buzz .4s ease-out .85s;
  }

  /* noise meter: arcs leaving the horn. Two of them, half a beat apart, so
     it reads as sound coming out rather than one ring pulsing. */
  .plat-tool.is-megaphone .tool-ic::before,
  .plat-tool.is-megaphone .tool-ic::after {
    content: '';
    position: absolute;
    /* the horn opens up and to the right, so the arcs leave from there and
       are tipped to match it — waves square to the tile read as a loading
       spinner rather than as sound */
    top: 34%;
    right: -9px;
    width: 20px;
    height: 20px;
    border: 3px solid transparent;
    border-right-color: var(--green-deep);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(-50%) rotate(-22deg) scale(.4);
  }
  @keyframes tool-wave {
    0%   { opacity: 0; transform: translateY(-50%) rotate(-22deg) scale(.4); }
    20%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-50%) rotate(-22deg) scale(1.5); }
  }
  .plat-card .plat-tool.is-megaphone:hover .obj { transform: translate(2px, -3px); }
  .plat-tool.is-megaphone:hover .tool-ic::before { animation: tool-wave 1.15s ease-out 2; }
  .plat-tool.is-megaphone:hover .tool-ic::after { animation: tool-wave 1.15s ease-out .38s 2; }

  @media (prefers-reduced-motion: reduce) {
    .plat-card .plat-tool.is-clock:hover .obj { animation: none; }
    .plat-tool.is-clock:hover .buzz-l,
    .plat-tool.is-clock:hover .buzz-r,
    .plat-tool.is-megaphone:hover .tool-ic::before,
    .plat-tool.is-megaphone:hover .tool-ic::after { animation: none; opacity: 0; }
  }

  /* a roster with a LIVE chip: the hero's badge grammar, sitting inside the
     blue card as a white panel */
  .plat-roster {
    margin: 0 var(--pad-card) var(--pad-card);
    padding: 12px 14px 12px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--e2);
  }
  .plat-roster .avs { display: flex; flex: none; }
  .plat-roster .avs span {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 2.5px solid #fff;
    margin-left: -10px;
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-size: 11px; font-weight: 800;
  }
  .plat-roster .avs span:first-child { margin-left: 0; }
  .plat-roster .txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .plat-roster .t1 { font-family: var(--font-display); font-weight: 800; font-size: 13.5px; color: var(--ink); }
  .plat-roster .t2 { font-size: 11.5px; font-weight: 600; color: var(--ink-3); white-space: nowrap; }
  .plat-roster .t2 b { color: var(--ink); font-variant-numeric: tabular-nums; }
  /* the LIVE pill itself is the shared `.shot-live` from style.css; the
     roster only pins it to the right and gives it a pixel more height */
  .plat-roster .shot-live { margin-left: auto; flex: none; padding-block: 4px; }

  @media (max-width: 1000px) {
    .plat-grid { grid-template-columns: repeat(4, 1fr); }
    .plat-card { grid-column: span 2; }
    /* below the desktop grid the screenshots need the whole row to stay
       legible; everything else pairs up */
    .plat-card.is-wide { grid-column: span 4; }
    .plat-card.is-half { grid-column: span 2; }
    /* five cards in pairs leave a hole; the analytics window is a wide
       chart, so it is the one that takes a full row without stretching */
    .plat-card.is-analytics { grid-column: span 4; }
    .plat-card.is-analytics .win-view { height: 176px; }
    /* the half card is 346px here and the roster's avatars and LIVE pill
       leave the text 95px — "4 дистанційно · 22 на зв'язку" on one line
       was cut off after the 22 */
    .plat-roster .t2 { white-space: normal; }
  }
  /* the pager is a phone control; above 760px the grid is a grid */
  .plat-dots { display: none; }

  /* ---- phones: a swipe strip, not seven stacked slabs ----
     Stacked one per row, this band was ~5800px tall on a 390px phone: seven
     cards, five of them carrying a browser window, all full width. That is
     six screens of scrolling for a feature list, and the two-up treatment
     that works for "why us" does not work here — a product screenshot at
     169px wide is a grey smear, so shrinking the cards would cost exactly the
     proof the band exists to give.

     So the cards keep their size and the band gives up its height instead:
     one card per screen, swiped sideways with scroll-snap, a pager
     underneath. The strip bleeds to both viewport edges (negative margin,
     matching padding) so the next card peeks in at the right — without that
     peek a snapping carousel reads as a single static card. */
  @media (max-width: 760px) {
    .plat-grid {
      display: flex;
      grid-template-columns: none;
      gap: 12px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 10px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .plat-grid::-webkit-scrollbar { display: none; }

    .plat-card,
    .plat-card.is-wide,
    .plat-card.is-half,
    .plat-card.is-analytics {
      grid-column: auto;
      flex: 0 0 min(86%, 360px);
      scroll-snap-align: start;
    }
    /* Inside a horizontal scroller the reveal's 20px drop never resolves for
       the cards still off to the right, and a card that is 20px lower than
       its neighbours makes the strip's height wobble as you swipe. The band
       head still reveals; the cards arrive with the swipe instead. */
    .plat-grid .reveal { transform: none; }
    /* every card the same height, so the pager underneath does not jump */
    .plat-card:not(.is-wide) h3 { min-height: 0; }
    .win-view, .plat-card.is-wide .win-view { height: 168px; }
    .plat-card.is-analytics .win-view img { width: var(--zoom); }
    .plat-tool { padding: 12px 6px 10px; font-size: .75rem; }
    .plat-tool .obj, .plat-tool .tool-ic { width: 44px; height: 44px; }
    .plat-roster { gap: 10px; padding: 10px 12px 10px 10px; }
    .plat-roster .t2 { white-space: normal; }

    .plat-dots {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 4px;
    }
    /* 7px of ink inside a 26px tap target: the dot is what you see, the
       padding is what you hit. */
    .plat-dot {
      width: 26px; height: 26px;
      border: 0;
      padding: 0;
      background: none;
      cursor: pointer;
      display: grid;
      place-items: center;
    }
    .plat-dot::before {
      content: '';
      width: 7px; height: 7px;
      border-radius: var(--r-pill);
      background: var(--line);
      transition: background 160ms linear, width 240ms var(--ease-spring);
    }
    .plat-dot.is-active::before { width: 20px; background: var(--ink); }
    .plat-dot:focus { outline: none; }
    .plat-dot:focus-visible { outline: none; box-shadow: var(--focus-ring); border-radius: var(--r-pill); }
  }
</style>

<script>
  /*
   * The pager under the platform strip. Below 760px the grid is a
   * scroll-snap carousel (see the media query); this keeps the dots and the
   * scroll position agreeing in both directions, and does nothing at all on
   * a desktop, where the dots are display:none and the grid never scrolls.
   *
   * The active card is the one whose centre is nearest the strip's centre,
   * rather than one computed from a card width — the cards are min(86%,
   * 360px) wide, which is a different number on every phone, and the last
   * card can never reach the left edge because the strip runs out of scroll
   * before it gets there.
   */
  const strip = document.querySelector<HTMLElement>('.plat-grid');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-plat-dot]'));
  const cards = strip ? Array.from(strip.children) as HTMLElement[] : [];

  if (strip && dots.length && cards.length) {
    let raf = 0;

    function active() {
      const mid = strip!.scrollLeft + strip!.clientWidth / 2;
      let best = 0;
      let bestGap = Infinity;
      cards.forEach((c, i) => {
        const gap = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid);
        if (gap < bestGap) { bestGap = gap; best = i; }
      });
      return best;
    }

    function sync() {
      const i = active();
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
    }

    strip.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; sync(); });
    }, { passive: true });

    dots.forEach((d, i) => {
      d.addEventListener('click', () => {
        const card = cards[i];
        if (!card) return;
        const pad = parseFloat(getComputedStyle(strip!).paddingLeft) || 0;
        strip!.scrollTo({
          left: card.offsetLeft - pad,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      });
    });

    sync();
    window.addEventListener('resize', sync);
  }
</script>
