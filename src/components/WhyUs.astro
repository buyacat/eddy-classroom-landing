---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props { locale: Locale }
const { locale } = Astro.props;

const items = tArray<{ icon: string; title: string; text: string }>(locale, 'classroom_why_items');

/*
 * One 3D object per card, plus a colour rhythm lifted from the mock: mostly
 * white cards with a green, a yellow and a blue block breaking the grid up.
 * The object hangs off the card's top-left corner rather than sitting in a
 * tinted plate — that overhang is the whole personality of this style.
 *
 * The rule for what goes in this map: the object has to illustrate the
 * card's own SENTENCE, not a neighbouring idea. Three of the six used to
 * fail that test — a padlock for offline (that is security), a handset for
 * multi-device (that is a phone call), an open book for 3D content (that is
 * a library of text) — so those three are drawn for this site instead, in
 * the pack's clay language. Sources in src/assets/icon-src/, rendered to
 * 256px PNGs next to the bought objects.
 *
 *   allInOne  folder   — a container holding many things is literally
 *                        "все в одному місці"
 *   journal   check    — the green tick of an answer landing while the
 *                        lesson is still running
 *   library   cube3d   — a cube is the thing the library is full of; a book
 *                        only says "library" and loses the 3D entirely
 *   ai        lightbulb— the assistant's output is an idea for the lesson
 *   offline   offline  — struck-through wifi, matching the headline, which
 *                        is itself written as a negation
 *   devices   devices  — laptop, tablet and phone carrying the SAME app
 *                        mark: the card's claim is "one app", not "many
 *                        gadgets"
 */
const objects: Record<string, string> = {
  allInOne: 'document',
  journal: 'check',
  library: 'cube3d',
  ai: 'lightbulb',
  offline: 'offline',
  devices: 'devices'
};

const blocks = ['', 'is-green', '', 'is-yellow', '', 'is-blue'];
---

<section class="band why" id="why">
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow">{t(locale, 'classroom_why_eyebrow')}</span>
      <h2 set:html={t(locale, 'classroom_why_title')} />
    </div>

    <div class="why-grid">
      {items.map((it, i) => (
        <article class={`card reveal ${blocks[i] || ''}`.trim()} style={`--i:${i}`}>
          <img class="obj" src={withBase(`/assets/icons/${objects[it.icon] || 'document'}.png`)}
               width="256" height="256" alt="" loading="lazy" decoding="async" />
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* No background here: the band lets the page-wide ambient plane through. It
     used to repaint an opaque #f5f5f5 identical to body's own, which bought
     nothing and would now cover the light. */
  .why::before {
    background:
      /* Green is this system's reassurance colour — the offline chip, the
         live dot, the is-green card three tiles down. "Why us" is the
         reassurance band. This pool does not introduce the green: it
         continues the hero's, which already lies in this band's top padding.
         It sits low enough to pass under the first row of cards, so it does
         not tint the white balance of the 3D objects hanging off them. */
      radial-gradient(var(--amb-r-lg) calc(var(--amb-r-lg) * .62) at 2% 52%,
        rgba(var(--amb-green), var(--amb-2)) 0%,
        rgba(var(--amb-green), 0) var(--amb-fade)),
      /* Blue low and right, so the eye is already in Platform's colour before
         it arrives there. The centre stays inside the BAND, not merely inside
         the box — at 104% it was an ellipse hanging below the box and all you
         saw was the straight line where the box stopped; at 84% it was still
         out in the overhang, which left the fade 13px less room than it needs
         and put that line back, fainter. The band occupies 20%–80% of its own
         box, and that is the range a centre may use. */
      radial-gradient(var(--amb-r-lg) calc(var(--amb-r-lg) * .58) at 94% 78%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) var(--amb-fade));
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(258px, 30%, 340px), 1fr));
    gap: var(--gap-card);
    /* the objects overhang the cards, so the grid needs headroom */
    margin-top: clamp(52px, 5vw, 76px);
  }
  /* a one- and a two-line title in the same row must still align their
     body copy — Ukrainian card titles wrap unpredictably */
  .why-grid h3 { min-height: calc(2 * 1.22em); }

  @media (max-width: 700px) {
    .why-grid h3 { min-height: 0; }
  }
</style>
