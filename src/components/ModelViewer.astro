---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';
import geometry from '../data/models.json';

interface Props { locale: Locale }
const { locale } = Astro.props;

/**
 * Lazy-loaded 3D model panel: nothing (model, three.js, loader) is fetched
 * until the panel scrolls near the viewport; then the first model loads on
 * its own, with no button to press. The structure list works without
 * WebGL/JS — it's plain HTML content, not a control panel for the 3D.
 * Runtime copy is passed as one `data-copy` payload so strings stay
 * translatable and the module stays copy-agnostic.
 */
/* Per-model copy comes from locale data; numbers (hotspots, explode) from
   models.json, since those are language-independent. Merged here once. */
type Geometry = Record<string, { file: string; explode: unknown; parts: unknown }>;
const geo = geometry as Geometry;

const models = tArray<{
  id: string;
  name: string;
  title: string;
  meta: string;
  weight: string;
  parts: { node: string; label: string; desc: string }[];
}>(locale, 'classroom_library_models')
  .filter((m) => geo[m.id])
  .map((m) => ({
    ...m,
    url: withBase(geo[m.id].file),
    explode: geo[m.id].explode,
    geometry: geo[m.id].parts
  }));

/* Opens on the first model, rendered server-side so the page is complete
   before script runs. */
const first = models[0];
const parts = first?.parts ?? [];
const alt = t(locale, 'classroom_library_model_alt');

const copy = {
  loading: t(locale, 'classroom_library_model_loading'),
  error: t(locale, 'classroom_library_model_error'),
  /* For cells with no file yet (see the "soon" state below). */
  soonBadge: t(locale, 'classroom_library_soon_badge'),
  soonDesc: t(locale, 'classroom_library_soon_desc')
};
---

<section class="mv reveal" data-model-viewer
         data-models={JSON.stringify(models)}
         data-copy={JSON.stringify(copy)}
         data-alt={alt}
         data-nowebgl={t(locale, 'classroom_library_model_nowebgl')}>
  <!-- Controls are a sibling of the stage: floated over it on desktop,
       moved below it on mobile via one `position` switch. -->
  <div class="mv-view">
    <div class="mv-stage" data-stage>
      <canvas class="mv-canvas" role="img" aria-label={`${alt} — ${first?.title ?? ''}`}></canvas>

      <!-- Only shown without WebGL: the weight line carries the explanation then. -->
      <div class="mv-gate" data-gate hidden>
        <p class="mv-weight" data-weight>{first?.weight}</p>
      </div>

      <!-- Visible from the server render: the model starts fetching as soon as the panel nears the viewport. -->
      <div class="mv-load is-unknown" data-load>
        <span class="mv-track"><i data-bar></i></span>
        <p class="mv-load-txt" data-load-txt>{copy.loading}… · {first?.weight}</p>
      </div>

      <div class="mv-fail" data-fail hidden>
        <p class="mv-fail-txt" data-fail-txt>{copy.error}</p>
        <button class="btn btn-ghost mv-retry" type="button" data-retry>
          {t(locale, 'classroom_library_model_retry')}
        </button>
      </div>

      {/* Shown when a cell with no .glb behind it is picked; toggled via `.mv.is-soon`. */}
      <div class="mv-soon" data-soon>
        <img class="mv-soon-ic" data-soon-icon src="" width="120" height="120" alt="" />
        <p class="mv-soon-badge">{copy.soonBadge}</p>
      </div>

      <!-- Callout for the picked structure: dot on the geometry, leader line, name clear of the model. -->
      <span class="mv-marker" data-marker hidden aria-hidden="true">
        <i class="mv-marker-dot"></i>
        <i class="mv-marker-line"></i>
        <b data-marker-label></b>
      </span>

      <span class="mv-hint" data-hint hidden>{t(locale, 'classroom_library_model_hint')}</span>
    </div>

    <div class="mv-tools" data-tools hidden>
      <label class="mv-slider">
        <span class="mv-slider-lbl">{t(locale, 'classroom_library_model_explode')}</span>
        <input type="range" min="0" max="100" step="1" value="0" data-explode-range />
      </label>
      <span class="mv-buttons">
        <button class="mv-btn" type="button" data-zoom="out"
                aria-label={t(locale, 'classroom_library_model_zoom_out')}>
          <span aria-hidden="true">–</span>
        </button>
        <button class="mv-btn" type="button" data-zoom="in"
                aria-label={t(locale, 'classroom_library_model_zoom_in')}>
          <span aria-hidden="true">+</span>
        </button>
        <button class="mv-btn is-wide" type="button" data-reset>
          {t(locale, 'classroom_library_model_reset')}
        </button>
      </span>
    </div>
  </div>

  <div class="mv-side">
    <span class="eyebrow">{t(locale, 'classroom_library_model_eyebrow')}</span>
    <h3 class="mv-ttl">{first?.title}</h3>
    <p class="mv-meta">{first?.meta}</p>
    <p class="mv-desc">{t(locale, 'classroom_library_model_desc')}</p>

    <p class="mv-parts-ttl">{t(locale, 'classroom_library_model_parts_title')}</p>
    <ul class="mv-parts" data-parts-list>
      {parts.map((p, i) => (
        <li>
          <button class={`mv-part${i === 0 ? ' is-on' : ''}`} type="button"
                  data-part={p.node} aria-pressed={i === 0 ? 'true' : 'false'}>
            {p.label}
          </button>
        </li>
      ))}
    </ul>
    {/* Server-rendered with the first structure's text so the live region below has content to replace, not announce. */}
    <p class="mv-part-desc" data-part-desc aria-live="polite">{parts[0]?.desc}</p>
  </div>
</section>

<style>
  .mv {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(20px, 2.6vw, 40px);
    align-items: start;
    margin-top: clamp(28px, 3.4vw, 48px);
    padding: clamp(16px, 1.8vw, 24px);
    background: #fff;
    border-radius: var(--r-2xl);
    box-shadow: var(--e3);
  }

  /* ---- the stage ---- */
  /* 4:3, not square — a square stage left ~150px of empty white under the side column. */
  .mv-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-xl);
    overflow: hidden;
    /* Same two-pool gradient as the hero panel's lighting. */
    background:
      radial-gradient(circle at 50% 48%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) 62%),
      radial-gradient(circle at 76% 24%,
        rgba(var(--amb-yellow), var(--amb-2)) 0%,
        rgba(var(--amb-yellow), 0) 58%),
      var(--surface);
  }

  .mv-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    opacity: 0;
    transition: opacity 520ms var(--ease-out);
  }
  .mv.is-live .mv-canvas { opacity: 1; }
  .mv-canvas:active { cursor: grabbing; }

  /* ---- cover / loading / failure / soon: one box, four states ---- */
  .mv-gate, .mv-load, .mv-fail, .mv-soon {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    text-align: center;
  }
  .mv-gate[hidden], .mv-load[hidden], .mv-fail[hidden] { display: none; }

  /* ---- the "soon" state: one root class swaps the whole stage ---- */
  .mv-soon { display: none; gap: 16px; }
  .mv.is-soon .mv-soon { display: flex; }
  .mv.is-soon .mv-gate, .mv.is-soon .mv-load, .mv.is-soon .mv-fail,
  .mv.is-soon .mv-canvas, .mv.is-soon .mv-marker, .mv.is-soon .mv-hint,
  .mv.is-soon .mv-tools { display: none; }
  .mv.is-soon .mv-parts-ttl, .mv.is-soon .mv-parts, .mv.is-soon .mv-part-desc { display: none; }

  .mv-soon-ic {
    width: 84px;
    height: 84px;
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, .22));
  }
  .mv-soon-badge {
    margin: 0;
    padding: 5px 14px;
    border-radius: var(--r-pill);
    background: var(--surface-sunken);
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .mv-weight, .mv-load-txt, .mv-fail-txt {
    margin: 0;
    font-size: .8125rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink-3);
    max-width: 30ch;
  }

  /* Progress bar rather than spinner; falls back to an indeterminate sweep
     when the server doesn't declare a content length. */
  .mv-track {
    width: min(220px, 70%);
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--surface-sunken);
    overflow: hidden;
  }
  .mv-track i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--blue);
    transition: width 180ms linear;
  }
  .mv-load.is-unknown .mv-track i {
    width: 40%;
    animation: mv-sweep 1.3s var(--ease-in-out) infinite;
  }
  @keyframes mv-sweep {
    0% { transform: translateX(-110%); }
    100% { transform: translateX(260%); }
  }

  /* ---- the callout ----
     Row: dot, hairline, name. Module sets `transform` to the projected point;
     `translate` (applied before `transform`) offsets the row so the dot lands
     on it. `is-left` reverses the row to hang off its own right edge instead. */
  .mv-marker {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    translate: -5px -50%;
    pointer-events: none;
  }
  .mv-marker.is-left {
    flex-direction: row-reverse;
    translate: calc(-100% + 5px) -50%;
  }
  .mv-marker[hidden] { display: none; }

  .mv-marker-dot {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, .85);
  }

  /* Length written by the module; shortened rather than letting the name run off the stage. */
  .mv-marker-line {
    width: var(--lead, 92px);
    height: 1px;
    flex: none;
    background: var(--ink-4);
    opacity: .6;
  }

  .mv-marker b {
    /* it may wrap, and at two lines the leader still meets it in the middle */
    max-width: 44%;
    padding: 4px 11px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .94);
    box-shadow: var(--e2);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--ink);
  }

  /* `.is-jumped` (set by initSnap in app.js when a reader jumps straight to
     this section) disables the reveal transition so the card just appears. */
  .reveal.mv.is-jumped { transition: none; }

  /* the stage's positioning context, and the toolbar's */
  .mv-view { position: relative; }

  /* ---- controls ---- */
  .mv-tools {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 14px;
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, .92);
    backdrop-filter: blur(6px);
    box-shadow: var(--e3);
  }
  .mv-tools[hidden] { display: none; }

  .mv-slider { display: flex; align-items: center; gap: 10px; flex: 1 1 180px; min-width: 0; }
  .mv-slider-lbl {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
  }
  /* Track/thumb spelled out twice: WebKit and Firefox use different pseudo-elements. */
  .mv-slider input {
    flex: 1 1 auto;
    min-width: 0;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    border-radius: var(--r-pill);
    background: var(--surface-sunken);
    cursor: pointer;
  }
  .mv-slider input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: var(--blue);
    box-shadow: var(--e2);
  }
  .mv-slider input::-moz-range-thumb {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: var(--blue);
    box-shadow: var(--e2);
  }
  .mv-slider input:focus-visible { outline: none; box-shadow: var(--focus-ring); }

  .mv-buttons { display: flex; align-items: center; gap: 6px; }
  .mv-btn {
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--surface-sunken);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
    transition: background var(--t-micro) linear;
  }
  .mv-btn.is-wide { font-size: 11.5px; padding: 0 12px; }
  .mv-btn:hover { background: var(--line); }
  .mv-btn:focus-visible { outline: none; box-shadow: var(--focus-ring); }

  .mv-hint {
    position: absolute;
    left: 50%;
    top: 14px;
    translate: -50% 0;
    padding: 6px 13px;
    border-radius: var(--r-pill);
    background: rgba(13, 13, 15, .82);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    pointer-events: none;
  }
  .mv-hint[hidden] { display: none; }
  /* it has said its piece by the time a hand has been on the model */
  .mv.is-touched .mv-hint { opacity: 0; transition: opacity 300ms var(--ease-out); }

  /* ---- the side: what the thing actually is ---- */
  .mv-side { padding: clamp(6px, 1vw, 16px) clamp(4px, 1vw, 14px); }
  .mv-ttl { margin-top: 16px; font-size: clamp(1.375rem, 1.05rem + 1.1vw, 1.875rem); }
  .mv-meta {
    margin-top: 8px;
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .mv-desc { margin-top: 14px; font-size: .9375rem; line-height: 1.55; color: var(--ink-2); }

  .mv-parts-ttl {
    margin: clamp(18px, 2vw, 26px) 0 10px;
    font-family: var(--font-display);
    font-size: .8125rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink);
  }
  /* Grid, not a flow layout — long structure names caused ragged wrapping in a flow. */
  .mv-parts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(186px, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mv-parts li { display: flex; }
  .mv-part {
    flex: 1;
    border: 0;
    border-radius: var(--r-lg);
    padding: 8px 13px;
    background: var(--surface);
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 800;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition: background var(--t-micro) linear, color var(--t-micro) linear;
  }
  .mv-part:hover { background: var(--surface-sunken); color: var(--ink); }
  .mv-part.is-on { background: var(--ink); color: #fff; }
  .mv-part:focus-visible { outline: none; box-shadow: var(--focus-ring); }

  /* Reserved height — a resizing box would shift the buttons under the pointer. */
  .mv-part-desc {
    margin-top: 14px;
    min-height: 6.4em;
    font-size: .875rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .mv { grid-template-columns: 1fr; }
    /* stacked, the stage has the full column to itself and the height it
       gives back would only be white space — so it takes the room */
    .mv-stage { aspect-ratio: 1 / 1; }
    .mv-part-desc { min-height: 0; }

    /* No room for leader + name at this width; the picked structure's button
       in the list below shows the name instead. Dot says WHERE, list says WHAT. */
    .mv-marker-line, .mv-marker b { display: none; }
  }
  @media (max-width: 560px) {
    /* Moved below the stage — two rows of controls over it covered the model. */
    .mv-tools {
      position: static;
      margin-top: 10px;
      padding: 10px 12px;
      gap: 9px;
      background: var(--surface);
      box-shadow: none;
      backdrop-filter: none;
    }
    .mv-slider { flex-basis: 140px; }
    .mv-hint { font-size: 10px; padding: 5px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mv-canvas, .mv-track i { transition: none; }
    .mv-load.is-unknown .mv-track i { animation: none; }
  }
</style>

<script>
  import type {
    ExplodeSpec,
    PartGeometry,
    PartSpec,
    ViewerHandle
  } from '../scripts/model-viewer';

  /** A model with a file behind it: the copy, and the numbers beside the .glb. */
  interface ModelSpec {
    id: string;
    name: string;
    title: string;
    meta: string;
    weight: string;
    url: string;
    parts: PartSpec[];
    geometry: Record<string, PartGeometry>;
    explode: ExplodeSpec;
  }

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  const root = document.querySelector<HTMLElement>('[data-model-viewer]');

  if (root) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const models = JSON.parse(root.dataset.models || '[]') as ModelSpec[];
    const copy = JSON.parse(root.dataset.copy || '{}') as {
      loading: string;
      error: string;
      soonDesc?: string;
    };
    const alt = root.dataset.alt || '';

    const partsList = q('[data-parts-list]');
    const partDesc = q('[data-part-desc]');
    const markerLabel = q('[data-marker-label]');
    const ttl = q('.mv-ttl');
    const meta = q('.mv-meta');
    const desc = q('.mv-desc');
    const weight = q('[data-weight]');
    const canvas = q<HTMLCanvasElement>('.mv-canvas');
    const soonIcon = root.querySelector<HTMLImageElement>('[data-soon-icon]');

    const gate = q('[data-gate]');
    const load = q('[data-load]');
    const loadTxt = q('[data-load-txt]');
    const bar = q<HTMLElement>('[data-bar]');
    const fail = q('[data-fail]');
    const tools = q('[data-tools]');
    const hint = q('[data-hint]');
    const range = q<HTMLInputElement>('[data-explode-range]');

    /* Captured before showSoon() can overwrite the description paragraph. */
    const aboutModels = desc.textContent ?? '';

    const webgl = hasWebGL();
    let active = models[0];
    let viewer: ViewerHandle | null = null;
    /* Matches the first structure already chosen in the server-rendered markup. */
    let current = active?.parts[0]?.node ?? null;
    markerLabel.textContent = active?.parts[0]?.label ?? '';

    /* Works with or without a mounted viewer — 3D calls are guarded. */
    function pick(node: string | null, fromClick: boolean) {
      current = node;
      const spec = active?.parts.find((p) => p.node === node) ?? null;

      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-part]')) {
        const on = b.dataset.part === node;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      partDesc.textContent = spec?.desc ?? '';
      markerLabel.textContent = spec?.label ?? '';
      viewer?.select(node);

      /* Auto-opens the model so a highlighted-but-sealed part is visible. */
      if (fromClick && viewer && Number(range.value) < 35) {
        range.value = '100';
        viewer.setExplode(1);
      }
    }

    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-part]')) {
      b.addEventListener('click', () => pick(b.dataset.part ?? null, true));
    }

    /* Rebuilt by cloning the server-rendered row, not `createElement` —
       Astro's scoped-CSS `data-astro-cid-…` attribute only exists on the
       original markup, so a fresh element would render unstyled. */
    const rowTemplate = partsList.querySelector('li')?.cloneNode(true) as HTMLLIElement | undefined;

    function renderParts() {
      if (!rowTemplate) return;
      partsList.textContent = '';
      for (const p of active.parts) {
        const li = rowTemplate.cloneNode(true) as HTMLLIElement;
        const b = li.querySelector('button')!;
        b.className = 'mv-part';
        b.dataset.part = p.node;
        b.setAttribute('aria-pressed', 'false');
        b.textContent = p.label;
        b.addEventListener('click', () => pick(p.node, true));
        partsList.appendChild(li);
      }
      pick(active.parts[0]?.node ?? null, false);
    }

    function progress(fraction: number) {
      // -1 means the server never said how big the file is; sweep instead
      // of printing a percentage that would be a guess
      load.classList.toggle('is-unknown', fraction < 0);
      if (fraction < 0) {
        loadTxt.textContent = copy.loading + '… · ' + active.weight;
        return;
      }
      bar.style.width = Math.round(fraction * 100) + '%';
      loadTxt.textContent = copy.loading + ' · ' + Math.round(fraction * 100) + '% · ' + active.weight;
    }

    /* Stamps each mount so a stale in-flight fetch (switched cells mid-download)
       is discarded on arrival instead of replacing the current model. */
    let generation = 0;
    let fetching = false;
    function fetchModel() {
      if (!webgl || fetching || viewer || !active) return;
      fetching = true;
      const mine = generation;
      gate.hidden = true;
      fail.hidden = true;
      load.hidden = false;
      bar.style.width = '0%';
      progress(-1);

      /* three.js, the loader and the model file are all fetched from here. */
      import('../scripts/model-viewer')
        .then((mod) =>
          mod.mountViewer({
            host: q('[data-stage]'),
            canvas,
            marker: q('[data-marker]'),
            caption: markerLabel,
            url: active.url,
            parts: active.parts,
            geometry: active.geometry,
            explode: active.explode,
            onProgress: (fraction) => {
              if (mine === generation) progress(fraction);
            }
          })
        )
        .then((handle) => {
          if (mine !== generation) {
            handle.destroy();
            return;
          }
          viewer = handle;
          load.hidden = true;
          tools.hidden = false;
          hint.hidden = false;
          root.classList.add('is-live');
          // reflect the selection the page already made, WITHOUT the
          // auto-open above: nobody asked for the model to be apart yet
          handle.select(current);
        })
        .catch(async (err) => {
          if (mine !== generation) return;
          /* Console gets the specific cause (network vs WebGL); panel shows one generic message. */
          let reach = 'not probed';
          try {
            const probe = await fetch(active.url, { method: 'HEAD', cache: 'no-store' });
            reach = 'HTTP ' + probe.status;
          } catch (netErr) {
            reach = 'network: ' + (netErr as Error).message;
          }
          console.error('[model] ' + active.id + ' failed to load — ' + active.url
            + ' (' + reach + '); cause:', err);
          load.hidden = true;
          fail.hidden = false;
        })
        .finally(() => {
          if (mine === generation) fetching = false;
        });
    }

    /* Releases everything the stage holds: model, canvas state, active cover. */
    function clearStage() {
      generation += 1;
      fetching = false;
      viewer?.destroy();
      viewer = null;
      load.hidden = true;
      fail.hidden = true;
      tools.hidden = true;
      hint.hidden = true;
      range.value = '0';
      root.classList.remove('is-live', 'is-touched');
    }

    /** A cell with a file behind it: this panel becomes that model. */
    function showModel(id: string) {
      const next = models.find((m) => m.id === id);
      if (!next) return;

      const leavingSoon = root.classList.contains('is-soon');
      root.classList.remove('is-soon');

      if (next === active) {
        // the same model, coming back from the "soon" state that borrowed its
        // headings — the model itself was never unloaded, so nothing else here
        if (leavingSoon) {
          ttl.textContent = next.title;
          meta.textContent = next.meta;
          desc.textContent = aboutModels;
        }
        return;
      }

      clearStage();
      active = next;
      ttl.textContent = next.title;
      meta.textContent = next.meta;
      desc.textContent = aboutModels;
      /* No-WebGL browsers show the explanation here instead of a file weight — leave it alone. */
      if (webgl) weight.textContent = next.weight;
      canvas.setAttribute('aria-label', alt + ' — ' + next.title);
      renderParts();

      /* A pick from the strip is as good as a scroll-in: it downloads at once. */
      if (webgl) fetchModel();
    }

    /** A cell with no file behind it yet: say so, rather than mime a load. */
    function showSoon(name: string, label: string, icon?: string) {
      root.classList.add('is-soon');
      ttl.textContent = name;
      meta.textContent = label.toUpperCase();
      if (copy.soonDesc) desc.textContent = copy.soonDesc;
      if (soonIcon && icon) soonIcon.src = icon;
    }

    /* One custom event decouples this panel from the strip above's markup. */
    root.addEventListener('mv:select', (event) => {
      const pickEvent = event as CustomEvent<{
        model?: string;
        name?: string;
        label?: string;
        icon?: string;
      }>;
      const { model, name, label, icon } = pickEvent.detail ?? {};
      if (model) showModel(model);
      else showSoon(name ?? '', label ?? '', icon);
    });

    if (!webgl) {
      /* Weight line reused for the no-WebGL explanation — a fresh <p> would
         lack the scoped-CSS attribute and render unstyled. */
      load.hidden = true;
      weight.textContent = root.dataset.nowebgl || '';
      gate.hidden = false;
    } else {
      const retry = q<HTMLButtonElement>('[data-retry]');
      retry.addEventListener('click', fetchModel);

      /* The model starts downloading ~600px before the panel enters the
         viewport, so by the time the visitor scrolls to it the eye is
         already turning. One-shot: once triggered the observer is dropped. */
      const near = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        fetchModel();
      }, { rootMargin: '600px 0px' });
      near.observe(root);

      range.addEventListener('input', () => {
        viewer?.setExplode(Number(range.value) / 100);
      });

      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-zoom]')) {
        b.addEventListener('click', () => {
          viewer?.zoom(b.dataset.zoom === 'in' ? 1.22 : 1 / 1.22);
        });
      }

      q<HTMLButtonElement>('[data-reset]').addEventListener('click', () => viewer?.resetView());

      // the hint has done its job the moment a hand lands on the model
      q('[data-stage]').addEventListener('pointerdown', () => {
        root.classList.add('is-touched');
      }, { once: true });
    }
  }
</script>
