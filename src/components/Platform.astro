---
import { t, tArray, getLocaleData } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';
import WheelIcon from './WheelIcon.astro';
import PlatformMock from './PlatformMock.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;

const items = tArray<{ icon: string; title: string; text: string; shot_alt?: string }>(
  locale,
  'classroom_platform_items'
);

const shots: Record<string, { url: string }> = {
  web: { url: 'classroom.eddygroup.eu/class' },
  student: { url: 'classroom.eddygroup.eu/my' },
  session: { url: 'classroom.eddygroup.eu/session' },
  panel: { url: 'classroom.eddygroup.eu/board' }
};

const blocks: Record<string, string> = {
  student: 'is-yellow',
  virtual: 'is-blue'
};

const half = new Set(['games', 'virtual']);

const tools = [
  { key: 'wheel', title: t(locale, 'classroom_hero_wheel_title'), tint: 'is-yellow' },
  { key: 'clock', title: t(locale, 'classroom_hero_timer_title'), tint: 'is-blue' },
  { key: 'megaphone', title: t(locale, 'classroom_hero_noise_title'), tint: 'is-green' }
];

const rosterTints = [
  { bg: 'var(--blue)', fg: '#fff' },
  { bg: 'var(--yellow)', fg: '#000' },
  { bg: 'var(--green)', fg: '#000' },
  { bg: 'var(--ink)', fg: '#fff' }
];
const mockStudents = (getLocaleData(locale).classroom_platform_mock as { students: { ini: string }[] }).students;
const roster = mockStudents.slice(0, 4).map((s, i) => ({ ini: s.ini, ...rosterTints[i] }));
---
<section class="band platform" id="platform">
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow">{t(locale, 'classroom_platform_eyebrow')}</span>
      <h2 set:html={t(locale, 'classroom_platform_title')} />
    </div>

    <div class="plat-grid">
      {items.map((it, i) => {
        const shot = shots[it.icon];
        const cls = [
          'card', 'plat-card', 'reveal',
          blocks[it.icon] || '',
          half.has(it.icon) ? 'is-half' : ''
        ].filter(Boolean).join(' ');
        return (
          <article class={cls} style={`--i:${i}`}>
            <div class="plat-body">
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>

            {shot && (
              <div class="plat-win">
                <span class="win-bar" aria-hidden="true">
                  <i class="d1"></i><i class="d2"></i><i class="d3"></i>
                  <span class="win-url">{shot.url}</span>
                </span>
                <span class="win-view" role="img" aria-label={it.shot_alt}>
                  <PlatformMock variant={it.icon as 'web' | 'session' | 'student' | 'panel'} locale={locale} />
                </span>
              </div>
            )}

            {it.icon === 'games' && (
              <ul class="plat-tools" aria-label={it.title}>
                {tools.map((tool) => (
                  <li class={`plat-tool ${tool.tint} is-${tool.key}`}>
                    <span class="tool-ic" aria-hidden="true">
                      {tool.key === 'wheel'
                        ? <WheelIcon />
                        : <img class="obj is-inline" src={withBase(`/assets/icons/${tool.key}.png`)}
                               width="256" height="256" alt="" loading="lazy" decoding="async" />}
                      {tool.key === 'clock' && (
                        <>
                          <i class="buzz buzz-l"></i>
                          <i class="buzz buzz-r"></i>
                        </>
                      )}
                    </span>
                    <span>{tool.title}</span>
                  </li>
                ))}
              </ul>
            )}

            {it.icon === 'virtual' && (
              <div class="plat-roster" aria-hidden="true">
                <span class="avs">
                  {roster.map((r) => (
                    <span style={`background:${r.bg};color:${r.fg}`}>{r.ini}</span>
                  ))}
                </span>
                <span class="txt">
                  <span class="t1">{t(locale, 'classroom_hero_roster_class')}</span>
                  <span class="t2"><b>22</b> {t(locale, 'classroom_platform_virtual_joined')}</span>
                </span>
                <span class="shot-live"><i class="pulse"></i>{t(locale, 'classroom_hero_panel_live')}</span>
              </div>
            )}
          </article>
        );
      })}
    </div>

    <div class="plat-dots" data-plat-dots>
      {items.map((it, i) => (
        <button class="plat-dot" type="button" data-plat-dot={i} aria-label={it.title}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .platform::before {
    background:
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .58) at 98% 22%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) var(--amb-fade)),
      radial-gradient(var(--amb-r-md) calc(var(--amb-r-md) * .62) at 2% 82%,
        rgba(var(--amb-yellow), var(--amb-2)) 0%,
        rgba(var(--amb-yellow), 0) var(--amb-fade)),
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .44) at 46% 56%,
        rgba(var(--amb-green), var(--amb-1)) 0%,
        rgba(var(--amb-green), 0) var(--amb-fade));
  }

  .plat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 1.8vw, 26px);
    margin-top: clamp(40px, 3.6vw, 56px);
  }

  .plat-card {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .plat-body { flex: none; padding: clamp(26px, 2.4vw, 34px) var(--pad-card) clamp(20px, 1.9vw, 28px); }
  .plat-card h3 { font-size: clamp(1.25rem, 1.05rem + .55vw, 1.625rem); }
  .plat-card p { font-size: .9375rem; max-width: 46ch; }

  .plat-card.is-blue { box-shadow: var(--e-blue); }
  .plat-card.is-blue:hover { box-shadow: 0 18px 40px -14px rgba(64, 80, 255, .6); }

  .plat-win {
    --win-inset: clamp(18px, 1.7vw, 28px);
    margin: auto var(--win-inset) var(--win-inset);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(15, 18, 45, .05), 0 20px 38px -20px rgba(15, 18, 45, .42);
    overflow: hidden;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #f1f2f7;
    border-bottom: 1px solid rgba(15, 18, 45, .07);
  }
  .win-bar i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .win-bar .d1 { background: #ff5f57; }
  .win-bar .d2 { background: #febc2e; }
  .win-bar .d3 { background: #28c840; }
  .win-url {
    flex: 1;
    min-width: 0;
    margin-left: 8px;
    height: 18px;
    padding: 0 9px;
    border-radius: var(--r-pill);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(15, 18, 45, .08);
    display: flex;
    align-items: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
  }
  .win-view {
    display: block;
    height: clamp(176px, 14vw, 204px);
    overflow: hidden;
    background: #fff;
  }

  .plat-card.is-half .plat-body { flex: 1; }
  .plat-card.is-half p { max-width: 44ch; }

  .plat-tools {
    list-style: none;
    margin: 0;
    padding: 0 var(--pad-card) var(--pad-card);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .plat-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 8px 12px;
    border-radius: var(--r-md);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: .8125rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .plat-tool.is-yellow { background: var(--yellow-soft); }
  .plat-tool.is-blue { background: var(--blue-soft); }
  .plat-tool.is-green { background: var(--green-soft); }

  .plat-tool {
    transition: transform var(--t-hover) var(--ease-out),
                box-shadow var(--t-hover) var(--ease-out);
  }
  .plat-tool:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(31, 44, 46, .09); }

  .plat-tool .tool-ic {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
  }
  .plat-tool .obj {
    width: 52px;
    height: 52px;
    flex: none;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .14));
    transition: transform var(--t-card) var(--ease-spring);
  }
  .plat-card:hover .plat-tool .obj { transform: translateY(-3px); }

  @keyframes tool-tremble {
    0%, 100% { transform: translate(0, -3px) rotate(0deg); }
    20%      { transform: translate(-.8px, -3px) rotate(-2.5deg); }
    40%      { transform: translate(.8px, -3.4px) rotate(2.5deg); }
    60%      { transform: translate(-.7px, -2.8px) rotate(-2deg); }
    80%      { transform: translate(.7px, -3.2px) rotate(1.8deg); }
  }
  .plat-card .plat-tool.is-clock:hover .obj {
    animation: tool-tremble .11s linear 4.5,
               tool-tremble .11s linear 4.5 .65s;
  }

  .plat-tool.is-clock .buzz {
    position: absolute;
    top: -5px;
    width: 15px;
    height: 15px;
    border: 2.5px solid transparent;
    border-top-color: var(--blue);
    border-radius: 50%;
    opacity: 0;
  }
  .plat-tool.is-clock .buzz::before {
    content: '';
    position: absolute;
    inset: 3.5px;
    border: 2.5px solid transparent;
    border-top-color: var(--blue);
    border-radius: 50%;
  }
  .plat-tool.is-clock .buzz-l { left: -7px; rotate: -48deg; }
  .plat-tool.is-clock .buzz-r { right: -7px; rotate: 48deg; }
  @keyframes tool-buzz {
    0%   { opacity: 0; scale: .7; }
    35%  { opacity: 1; scale: 1; }
    100% { opacity: 0; scale: 1.25; }
  }
  .plat-tool.is-clock:hover .buzz-l {
    animation: tool-buzz .4s ease-out,
               tool-buzz .4s ease-out .65s;
  }
  .plat-tool.is-clock:hover .buzz-r {
    animation: tool-buzz .4s ease-out .2s,
               tool-buzz .4s ease-out .85s;
  }

  .plat-tool.is-megaphone .tool-ic::before,
  .plat-tool.is-megaphone .tool-ic::after {
    content: '';
    position: absolute;
    top: 34%;
    right: -9px;
    width: 20px;
    height: 20px;
    border: 3px solid transparent;
    border-right-color: var(--green-deep);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(-50%) rotate(-22deg) scale(.4);
  }
  @keyframes tool-wave {
    0%   { opacity: 0; transform: translateY(-50%) rotate(-22deg) scale(.4); }
    20%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-50%) rotate(-22deg) scale(1.5); }
  }
  .plat-card .plat-tool.is-megaphone:hover .obj { transform: translate(2px, -3px); }
  .plat-tool.is-megaphone:hover .tool-ic::before { animation: tool-wave 1.15s ease-out 2; }
  .plat-tool.is-megaphone:hover .tool-ic::after { animation: tool-wave 1.15s ease-out .38s 2; }

  @media (prefers-reduced-motion: reduce) {
    .plat-card .plat-tool.is-clock:hover .obj { animation: none; }
    .plat-tool.is-clock:hover .buzz-l,
    .plat-tool.is-clock:hover .buzz-r,
    .plat-tool.is-megaphone:hover .tool-ic::before,
    .plat-tool.is-megaphone:hover .tool-ic::after { animation: none; opacity: 0; }
  }

  .plat-roster {
    margin: 0 var(--pad-card) var(--pad-card);
    padding: 12px 14px 12px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--e2);
  }
  .plat-roster .avs { display: flex; flex: none; }
  .plat-roster .avs span {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 2.5px solid #fff;
    margin-left: -10px;
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-size: 11px; font-weight: 800;
  }
  .plat-roster .avs span:first-child { margin-left: 0; }
  .plat-roster .txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .plat-roster .t1 { font-family: var(--font-display); font-weight: 800; font-size: 13.5px; color: var(--ink); }
  .plat-roster .t2 { font-size: 11.5px; font-weight: 600; color: var(--ink-3); white-space: nowrap; }
  .plat-roster .t2 b { color: var(--ink); font-variant-numeric: tabular-nums; }
  .plat-roster .shot-live { margin-left: auto; flex: none; padding-block: 4px; }

  @media (max-width: 1000px) {
    .plat-card h3 { font-size: clamp(1.125rem, 1rem + .5vw, 1.375rem); }
    .plat-roster .t2 { white-space: normal; }
  }
  .plat-dots { display: none; }

  @media (max-width: 760px) {
    .plat-grid {
      display: flex;
      grid-template-columns: none;
      gap: 12px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 10px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .plat-grid::-webkit-scrollbar { display: none; }

    .plat-card {
      flex: 0 0 min(86%, 360px);
      scroll-snap-align: start;
    }
    .plat-grid .reveal { transform: none; }
    .win-view { height: 168px; }
    .plat-tool { padding: 12px 6px 10px; font-size: .75rem; }
    .plat-tool .obj, .plat-tool .tool-ic { width: 44px; height: 44px; }
    .plat-roster { gap: 10px; padding: 10px 12px 10px 10px; }
    .plat-roster .t2 { white-space: normal; }

    .plat-dots {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 4px;
    }
    .plat-dot {
      width: 26px; height: 26px;
      border: 0;
      padding: 0;
      background: none;
      cursor: pointer;
      display: grid;
      place-items: center;
    }
    .plat-dot::before {
      content: '';
      width: 7px; height: 7px;
      border-radius: var(--r-pill);
      background: var(--line);
      transition: background 160ms linear, width 240ms var(--ease-spring);
    }
    .plat-dot.is-active::before { width: 20px; background: var(--ink); }
    .plat-dot:focus { outline: none; }
    .plat-dot:focus-visible { outline: none; box-shadow: var(--focus-ring); border-radius: var(--r-pill); }
  }
</style>

<script>
  const strip = document.querySelector<HTMLElement>('.plat-grid');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-plat-dot]'));
  const cards = strip ? Array.from(strip.children) as HTMLElement[] : [];

  if (strip && dots.length && cards.length) {
    let raf = 0;

    function active() {
      const mid = strip!.scrollLeft + strip!.clientWidth / 2;
      let best = 0;
      let bestGap = Infinity;
      cards.forEach((c, i) => {
        const gap = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid);
        if (gap < bestGap) { bestGap = gap; best = i; }
      });
      return best;
    }

    function sync() {
      const i = active();
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
    }

    strip.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; sync(); });
    }, { passive: true });

    dots.forEach((d, i) => {
      d.addEventListener('click', () => {
        const card = cards[i];
        if (!card) return;
        const pad = parseFloat(getComputedStyle(strip!).paddingLeft) || 0;
        strip!.scrollTo({
          left: card.offsetLeft - pad,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      });
    });

    sync();
    window.addEventListener('resize', sync);
  }
</script>
