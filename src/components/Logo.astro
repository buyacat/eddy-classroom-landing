---
/*
 * The lockup from the client's Frame 3 mock: heavy black EDDY, slightly
 * italic, followed by a black skewed tag holding a white lowercase
 * `classroom`. It replaces the old raster `eddy` script mark lifted out of
 * the app UI — this one is live type, so it stays sharp at any size and
 * recolours for the dark footer.
 *
 * TODO(brand): if the client ever supplies the real vector wordmark, drop
 * it in here; the two spans are a faithful reconstruction, not the original.
 */
interface Props {
  variant?: 'default' | 'inverse';
  /* `tag` drops the EDDY word and keeps only the skewed `classroom` chip —
     used in the group header, where the Eddy Group wordmark already sits
     to its left and repeating EDDY would read as a stutter. */
  part?: 'full' | 'tag';
  class?: string;
}
const { variant = 'default', part = 'full', class: cls = '' } = Astro.props;
---

<span class={`logo logo-${variant} ${cls}`.trim()} aria-label="Eddy Classroom">
  {part === 'full' && <span class="logo-eddy">EDDY</span>}
  <span class="logo-tag"><span>classroom</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    line-height: 1;
    font-family: var(--font-display);
  }
  .logo-eddy {
    font-weight: 800;
    font-size: var(--logo-size, 26px);
    letter-spacing: -.03em;
    color: var(--ink);
    transform: skewX(-8deg);
  }
  .logo-tag {
    display: inline-block;
    background: var(--ink);
    border-radius: 5px;
    padding: calc(var(--logo-size, 26px) * .16) calc(var(--logo-size, 26px) * .3);
    transform: skewX(-8deg);
  }
  .logo-tag > span {
    display: block;
    transform: skewX(8deg);
    color: #fff;
    font-weight: 800;
    font-size: calc(var(--logo-size, 26px) * .52);
    letter-spacing: -.01em;
  }

  .logo-inverse .logo-eddy { color: #fff; }
  .logo-inverse .logo-tag { background: #fff; }
  .logo-inverse .logo-tag > span { color: var(--ink); }
</style>
