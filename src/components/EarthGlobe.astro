---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

/*
 * The hero used to be a screenshot of a 3D lesson. Now it is one: a real,
 * draggable cut-away Earth, the same thing a teacher opens from the library.
 *
 * It used to be a quiz as well — pull the model apart and the panel handed you
 * a question, twenty-two pupils answered it, and the hero spent its last beat
 * on a percentage. The client asked for that half back out: the point of the
 * panel is the MODEL — turn it, take it apart, read what the pieces are called
 * — and a running test on top of it argued for attention with the one thing
 * the visitor came to see. What is left is the object and its captions.
 *
 * There is deliberately no poster image behind it. A still that gets swapped
 * for the live model just makes the panel jump on load, and the only still we
 * had was a different model entirely. Until the first rendered frame exists,
 * the panel simply holds its own light — nothing to flash and nothing to
 * replace. Geometry and materials live in the module; this file only carries
 * the localised labels.
 */
const layers = tArray<{ name: string; meta?: string }>(locale, 'classroom_hero_globe_layers');

/*
 * The one control on the panel, and the reason it exists at all: a drag is
 * the nicer way to take the model apart, and it is a gesture nobody can
 * discover with a keyboard and nobody can guess from a still screenshot. The
 * button says out loud what the model does, and it is the only route into the
 * exploded view for someone tabbing through the page.
 *
 * Both labels are handed over at once because the button is a toggle and the
 * model can be opened behind its back — a drag does it too — so the label has
 * to be able to change without a round trip for copy.
 */
const toggle = {
  open: t(locale, 'classroom_hero_globe_explode'),
  close: t(locale, 'classroom_hero_globe_collapse')
};
---

<!-- The picture is the canvas, so that is what carries the image role and
     the alt. It used to sit on the whole panel, which made everything inside
     it presentational for a screen reader — including the button below. -->
<div class="globe" data-globe data-layers={JSON.stringify(layers)}
     data-toggle-copy={JSON.stringify(toggle)}>
  <canvas class="globe-canvas" role="img" aria-label={t(locale, 'classroom_hero_globe_alt')}></canvas>
  <div class="globe-tags" aria-hidden="true"></div>
  <span class="globe-hint">{t(locale, 'classroom_hero_globe_hint')}</span>

  <div class="globe-foot">
    <p class="globe-note">{t(locale, 'classroom_hero_globe_scale_note')}</p>

    <!-- hidden until the model is actually running: a control for a scene
         that never mounted is a promise the panel cannot keep -->
    <button class="globe-toggle" type="button" data-explode hidden>
      <span class="globe-toggle-ico" aria-hidden="true"><i></i><i></i><i></i></span>
      <span data-explode-label>{toggle.open}</span>
    </button>
  </div>
</div>

<style>
  .globe {
    position: relative;
    aspect-ratio: 1080 / 1071;
    /* the soft halo the flat model sits in — cheaper than a real light rig */
    background:
      /* This plate was the first ambient wash on the site, written by hand
         before there were tokens. Its .09 and .16 landed almost exactly on
         --amb-1 and --amb-2, which is the best evidence the tiers are set
         right — so it consumes them now instead of restating them. */
      radial-gradient(circle at 52% 46%,
        rgba(var(--amb-blue), var(--amb-1)) 0%,
        rgba(var(--amb-blue), 0) 58%),
      /* The yellow used to sit at 68%/70% — dead under the lesson strip, so
         the controls looked like they were bleeding into a stain. It backs
         the model now, not the foot. */
      radial-gradient(circle at 74% 28%,
        rgba(var(--amb-yellow), var(--amb-1)) 0%,
        rgba(var(--amb-yellow), 0) 58%);
  }

  .globe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 620ms var(--ease-out);
  }

  .globe.is-live .globe-canvas { opacity: 1; }

  /* the drag surface itself */
  .globe-canvas { touch-action: none; cursor: grab; }
  .globe.is-grabbed .globe-canvas { cursor: grabbing; }

  /* ---- layer tags ---- */
  .globe-tags { position: absolute; inset: 0; pointer-events: none; }

  /* The leader from a shell down to the caption that names it — the same
     hairline the library's eye viewer uses, so the two models on this page
     annotate themselves the same way. 1px, --ink-4, and held well under full
     opacity by the module: its job is to connect, not to be seen. */
  .globe-tags :global(.globe-lead) {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    transform-origin: 0 50%;
    background: var(--ink-4);
    opacity: 0;
  }

  .globe-tags :global(.globe-tag) {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px 5px 4px;
    background: #fff;
    border-radius: var(--r-pill);
    box-shadow: var(--e3);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 160ms linear;
  }
  .globe-tags :global(.globe-tag span) {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .globe-tags :global(.globe-tag b) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 12px;
    color: var(--ink);
  }
  /* the depth and the state of matter — the half of the tag that teaches */
  .globe-tags :global(.globe-tag em) {
    font-style: normal;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .globe-tags :global(.globe-tag em:empty) { display: none; }
  /* the layer's place in the stack, counted from the surface down */
  .globe-tags :global(.globe-tag-dot) {
    width: 19px; height: 19px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 800;
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }

  /* ---- hint ---- */
  .globe-hint {
    position: absolute;
    left: 50%;
    top: 5%;
    translate: -50% 0;
    padding: 7px 15px;
    border-radius: var(--r-pill);
    background: rgba(13, 13, 15, .82);
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .01em;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 420ms var(--ease-out);
  }
  .globe.is-live .globe-hint { opacity: 1; animation: hint-bob 3.4s var(--ease-in-out) infinite; }
  .globe.is-touched .globe-hint { opacity: 0; animation: none; }

  @keyframes hint-bob { 0%, 100% { translate: -50% 0; } 50% { translate: -50% -4px; } }

  /* ---- everything that stacks along the bottom of the panel ---- */
  .globe-foot {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 4%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  /* ---- the honest caveat, shown only once the layers are apart ---- */
  .globe-note {
    display: none;
    margin: 0;
    text-align: center;
    font-size: 10.5px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--ink-4);
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }
  .globe.is-open .globe-note { display: block; opacity: 1; }

  /* ---- take apart / put back ----
     White, not blue. The hero already spends its one blue button on the lead
     form a column to the left; a second one inside the panel would read as
     the more important of the two, and this is a control on an object, not a
     call to action. */
  .globe-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px 9px 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: var(--e3);
    pointer-events: auto;
    transition: transform var(--t-hover) var(--ease-out), box-shadow var(--t-hover) var(--ease-out);
  }
  /* `hidden` alone loses to the display above, and a button that ships
     visible over a scene that never mounted is the exact failure this
     attribute exists to prevent */
  .globe-toggle[hidden] { display: none; }
  .globe-toggle:hover { transform: translateY(-1px); box-shadow: var(--e4); }
  .globe-toggle:focus-visible { outline: none; box-shadow: var(--focus-ring), var(--e3); }

  /* Three bars that move apart when the model does — the button's own small
     copy of what pressing it will do, drawn rather than fetched. The middle
     bar is the one that stays, the way the crust stays and the contents come
     out of it. */
  .globe-toggle-ico {
    position: relative;
    width: 17px;
    height: 13px;
    flex: none;
  }
  .globe-toggle-ico i {
    position: absolute;
    left: 50%;
    width: 13px;
    height: 3px;
    margin-left: -6.5px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 320ms var(--ease-spring);
  }
  .globe-toggle-ico i:nth-child(1) { top: 1px; }
  .globe-toggle-ico i:nth-child(2) { top: 5px; background: var(--blue); }
  .globe-toggle-ico i:nth-child(3) { top: 9px; }
  .globe.is-open .globe-toggle-ico i:nth-child(1) { transform: translateY(-2px) scaleX(.72); }
  .globe.is-open .globe-toggle-ico i:nth-child(3) { transform: translateY(2px) scaleX(.72); }

  /* On a narrow panel the model shrinks with the camera but the tags do not,
     so four full captions would pile up. The depth line is the first thing to
     go: the name and the order still carry the lesson. */
  @media (max-width: 760px) {
    .globe-tags :global(.globe-tag) { gap: 4px; padding: 3px 9px 4px 3px; }
    .globe-tags :global(.globe-tag b) { font-size: 10.5px; }
    .globe-tags :global(.globe-tag em) { display: none; }
    .globe-tags :global(.globe-tag-dot) { width: 16px; height: 16px; font-size: 9.5px; }

    .globe-note { font-size: 9.5px; }
    .globe-toggle { padding: 8px 15px 8px 12px; font-size: 12px; }
    /* the model badge sits over the panel's top-left corner on a phone
       (Hero.astro, `top: 4%`), and at 5% the hint ran into it — drop the
       hint below the badge; the sphere itself starts lower still */
    .globe-hint { top: 13%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .globe.is-live .globe-hint { animation: none; }
    .globe-toggle-ico i { transition: none; }
  }
</style>

<script>
  import type { LayerSpec } from '../scripts/earth';

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  const host = document.querySelector<HTMLElement>('[data-globe]');

  /*
   * Reduced motion no longer keeps the model off the page — it only silences
   * the parts of it that move unbidden (see REDUCED in scripts/earth.ts) and
   * cancels the one-time demo below. The panel IS the hero now; refusing to
   * mount it left a white rectangle where the product was supposed to be.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (host && hasWebGL()) {
    const canvas = host.querySelector<HTMLCanvasElement>('.globe-canvas')!;
    const tags = host.querySelector<HTMLElement>('.globe-tags')!;
    const button = host.querySelector<HTMLButtonElement>('[data-explode]')!;
    const label = host.querySelector<HTMLElement>('[data-explode-label]')!;
    const specs = JSON.parse(host.dataset.layers || '[]') as LayerSpec[];
    const copy = JSON.parse(host.dataset.toggleCopy || '{}') as { open: string; close: string };

    // three.js only leaves the network once the hero is in view
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();

      import('../scripts/earth')
        .then(async (earth) => {
          const globe = await earth.mountGlobe(host, canvas, tags, specs);

          /* The button's own idea of the state is whatever the model last
             said, never what it last asked for: a drag opens the model behind
             the button's back, and an `open(true)` that arrives while the
             planet is turned away is refused until it has turned round. */
          let open = false;
          globe.onOpenChange((next) => {
            open = next;
            label.textContent = next ? copy.close : copy.open;
          });
          button.addEventListener('click', () => globe.open(!open));
          button.hidden = false;

          /* The hint says the model comes apart; this shows it. It waits out
             the canvas fade first (620ms in the CSS above) so the demo is not
             played to a panel that is still arriving, and it bows out the
             moment a hand arrives — see demo() in the module. */
          if (!reduced) window.setTimeout(() => globe.demo(), 900);
        })
        .catch((err) => {
          // the panel keeps its own light and the page carries on; log it,
          // because a silently blank hero is worse than a noisy console
          console.warn('[globe] not mounted:', err);
        });
    }, { rootMargin: '200px' });

    io.observe(host);
  }
</script>
