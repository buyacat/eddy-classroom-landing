---
import { t, altPath } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props { locale: Locale }
const { locale } = Astro.props;

// Menu targets and the #1F2C2E link ink match the live eddygroup.eu header.
const links = [
  { href: 'https://trade.eddygroup.eu/', label: 'Trade' },
  { href: 'https://1vision.eddygroup.eu/', label: '1-Vision' },
  { href: 'https://drstem.eu/', label: 'Dr. STEM' },
  { href: 'https://svitlo.eddygroup.eu/', label: 'Svitlo' },
  {
    href: locale === 'uk' ? 'https://eddygroup.eu/news/' : 'https://eddygroup.eu/en/news/',
    label: t(locale, 'nav_news')
  },
  {
    href: locale === 'uk' ? 'https://eddygroup.eu/contact/' : 'https://eddygroup.eu/en/contact/',
    label: t(locale, 'nav_contacts')
  }
];
const alt = altPath(locale);
---

<header class="gnav" id="nav">
  <div class="gnav-bar">
   <div class="gnav-inner">
    <!-- Group mark links out to eddygroup.eu; product mark links to #top -->
    <div class="gnav-brand">
      <a href="https://eddygroup.eu/" class="gnav-group" target="_blank" rel="noopener">
        <img class="gnav-eddy" src={withBase('/assets/brand/eddy-black.svg')}
             alt="Eddy Group" width="158" height="26" />
      </a>
      <span class="gnav-vline" aria-hidden="true"></span>
      <a href="#top" class="gnav-product">
        <img class="gnav-mark" src={withBase('/assets/brand/classroom-mark.png')}
             alt="Eddy Classroom" width="127" height="26" />
      </a>
    </div>

    <nav class="gnav-links" aria-label="Eddy Group">
      {links.map((l) => (
        <a href={l.href} class="gnav-link" target="_blank" rel="noopener">{l.label}</a>
      ))}
    </nav>

    <div class="gnav-actions">
      <a href={alt} class="gnav-lang" aria-label={t(locale, 'nav_lang_aria')}>{t(locale, 'nav_lang_label')}</a>
      <button class="gnav-burger" id="nav-burger" type="button"
              aria-label={t(locale, 'nav_menu_open')} data-label-close={t(locale, 'nav_menu_close')}
              aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
     </div>
   </div>
  </div>

  <!-- The stack: three sheet edges fanned out under the bar at rest, closing
       into one 3px tri-colour line the moment the header sticks. -->
  <div class="gnav-stack" aria-hidden="true">
    <span class="sheet sheet-y"></span>
    <span class="sheet sheet-g"></span>
    <span class="sheet sheet-b"></span>
  </div>
</header>

<!-- Full-screen sheet, not a dropdown: CTA + language switch sit at the bottom, in thumb reach -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true"
     aria-label={t(locale, 'nav_menu_open')}>
  <div class="mm-scroll">
    <span class="mm-kicker">{t(locale, 'nav_menu_sites')}</span>

    <nav class="mm-nav" aria-label="Eddy Group">
      {links.map((l, i) => (
        <a href={l.href} class="mm-link" style={`--i:${i}`} target="_blank" rel="noopener">
          <span class="mm-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="mm-label">{l.label}</span>
          <svg class="mm-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12h13M12.5 6l6 6-6 6" fill="none" stroke="currentColor"
                  stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
    </nav>

    <div class="mm-foot" style={`--i:${links.length}`}>
      <a href="#demo" class="btn btn-primary mm-cta">{t(locale, 'classroom_hero_cta_primary')}</a>

      <div class="mm-row">
        <span class="mm-row-lbl">{t(locale, 'nav_menu_lang')}</span>
        <a href={alt} class="mm-lang" aria-label={t(locale, 'nav_lang_aria')}>
          <b>{locale === 'uk' ? 'UA' : 'EN'}</b>
          <i aria-hidden="true"></i>
          <span>{t(locale, 'nav_lang_label')}</span>
        </a>
      </div>

      <div class="mm-contacts">
        <a href={`mailto:${t(locale, 'footer_email')}`}>{t(locale, 'footer_email')}</a>
        <a href={`tel:${t(locale, 'footer_phone').replace(/[^+\d]/g, '')}`}>{t(locale, 'footer_phone')}</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Three coloured sheet edges fanned out in 3D under the bar; on scroll they close into one 3px line */
  .gnav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    perspective: 900px;
    perspective-origin: 50% 100%; /* vanishing point on the stack line */
    transition: filter 200ms var(--ease-out);
  }
  .gnav-bar {
    background: #fff;
    transition: box-shadow 220ms var(--ease-out);
  }
  .gnav.is-stuck .gnav-bar { box-shadow: 0 4px 10px rgba(0, 0, 0, .05); }

  /* Bar itself never transforms (avoids distorting its text) — all motion lives in the sheets below */

  .gnav-stack {
    position: absolute;
    inset: 100% 0 auto;
    height: 26px;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .sheet {
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    border-radius: 0 0 3px 3px;
    clip-path: inset(0 0 0 0);
    will-change: transform, clip-path;
    /* order matters: the per-state rules below address these four transitions by index */
    transition:
      transform 1050ms var(--ease-glide),
      clip-path 850ms var(--ease-glide),
      opacity 380ms var(--ease-out),
      height 650ms var(--ease-glide);
  }
  /* scaleX steps the fan predictably at any width; translateZ keeps layers genuinely apart in 3D */
  .sheet-y { background: var(--yellow); z-index: 3; }
  .sheet-g {
    background: var(--green);
    z-index: 2;
    transform: translate3d(0, 6px, -22px) scaleX(.964);
    transition-delay: 60ms;
  }
  .sheet-b {
    background: var(--blue);
    z-index: 1;
    transform: translate3d(0, 12px, -46px) scaleX(.928);
    transition-delay: 120ms;
  }

  /* Closed until page ready, so the stack fans open on load via the transition above (no keyframes) */
  html:not(.is-loaded) .sheet { transform: none; }

  /* Closing: sheets rise into one row, staggered back to front, each clipped to its own third.
     Synced with the hero's blob fade via html.nav-stuck (see Hero.astro). */
  .gnav.is-stuck .sheet { height: 5px; }
  .gnav.is-stuck .sheet-y {
    clip-path: inset(0 66.67% 0 0);
    transition-delay: 0ms, 300ms, 0ms, 260ms;
  }
  .gnav.is-stuck .sheet-g {
    transform: translate3d(0, 0, 0);
    clip-path: inset(0 33.34% 0 33.33%);
    transition-delay: 110ms, 340ms, 0ms, 260ms;
  }
  .gnav.is-stuck .sheet-b {
    transform: translate3d(0, 0, 0);
    clip-path: inset(0 0 0 66.66%);
    transition-delay: 220ms, 380ms, 0ms, 260ms;
  }

  .gnav-inner {
    height: var(--nav-h);
    padding-inline: clamp(16px, 4.6vw, 70px); /* eddygroup.eu's 70px gutter, not a centred column */
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 20px;
  }

  .gnav-brand { display: flex; align-items: center; gap: 13px; min-width: 0; }
  /* min-width: 0 also needed on these flex children (their content-size floor otherwise overflows into the burger) */
  .gnav-group, .gnav-product { display: flex; min-width: 0; }
  .gnav-group img, .gnav-product img { object-fit: contain; object-position: left center; }
  .gnav-eddy { height: 26px; width: auto; display: block; }
  .gnav-mark { height: 26px; width: auto; display: block; }
  .gnav-vline { width: 1px; height: 24px; background: rgba(31, 44, 46, .22); }

  .gnav-links { display: flex; justify-content: center; }
  .gnav-link {
    padding: 4px 15px;
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .9375rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #1f2c2e;
    transition: color var(--t-micro) var(--ease-out);
  }
  .gnav-link:hover { color: var(--blue); }

  /* flex: none — the actions column is the one that must never be squeezed:
     it holds the only two controls in the bar. */
  .gnav-actions { display: flex; flex: none; align-items: center; justify-content: flex-end; gap: 8px; }

  .gnav-lang {
    display: grid; place-items: center;
    min-width: 44px; height: 36px;
    padding-inline: 12px;
    border-radius: var(--r-pill);
    border: 2px solid var(--line);
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .8125rem;
    letter-spacing: .04em;
    color: #1f2c2e;
    transition: border-color var(--t-micro) var(--ease-out), background-color var(--t-micro) var(--ease-out), color var(--t-micro) var(--ease-out);
  }
  .gnav-lang:hover { border-color: var(--ink); background: var(--ink); color: #fff; }

  /* place-content (not place-items) — place-items only sets align-items, leaving rows to stretch
     and the bars misaligned, so the open state crossed off-centre and drew a chevron instead of an X. */
  .gnav-burger {
    display: none;
    width: 44px; height: 36px;
    border-radius: var(--r-pill);
    border: 2px solid var(--line);
    background: #fff;
    cursor: pointer;
    padding: 0;
    place-content: center;
    justify-items: center;
    gap: 4px;
  }
  .gnav-burger span {
    display: block;
    width: 18px; height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform var(--t-hover) var(--ease-out), opacity var(--t-micro) var(--ease-out);
  }
  .gnav-burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .gnav-burger.open span:nth-child(2) { opacity: 0; transform: scaleX(.2); }
  .gnav-burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .gnav-burger.open { border-color: var(--ink); }

  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0;
    z-index: 55;
    background: #fff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    clip-path: inset(0 0 100% 0); /* wipes up from under the bar rather than fading in place */
    transition:
      clip-path 420ms var(--ease-glide),
      opacity 200ms var(--ease-out),
      visibility 0s linear 420ms;
  }
  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 460ms var(--ease-glide),
      opacity 160ms var(--ease-out),
      visibility 0s linear 0s;
  }

  .mm-scroll {
    height: 100%;
    /* content is centred to a max measure, not full-bleed like the sheet itself */
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 5vw, 28px) var(--gutter) calc(clamp(20px, 5vw, 32px) + env(safe-area-inset-bottom));
  }

  .mm-kicker {
    display: block;
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .6875rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .mm-nav { margin-top: 10px; }

  .mm-link {
    display: grid;
    grid-template-columns: 26px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 15px 2px;
    border-bottom: 1px solid var(--line);
    color: #1f2c2e;
  }
  .mm-idx {
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .6875rem;
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
    transition: color var(--t-micro) var(--ease-out);
  }
  .mm-label {
    font-family: var(--font-group);
    font-weight: 800;
    font-size: clamp(1.375rem, 1.1rem + 2.2vw, 1.875rem);
    line-height: 1.1;
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  .mm-arrow {
    width: 22px; height: 22px;
    color: var(--ink-4);
    transition: transform var(--t-hover) var(--ease-out), color var(--t-micro) var(--ease-out);
  }
  .mm-link:active .mm-label { color: var(--blue); }
  .mm-link:active .mm-arrow { color: var(--blue); transform: translateX(4px); }
  .mm-link:active .mm-idx { color: var(--blue); }

  /* ---- the foot: what a thumb can reach ---- */
  .mm-foot { margin-top: auto; padding-top: clamp(22px, 6vw, 34px); }
  .mm-cta { width: 100%; justify-content: center; }

  .mm-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
  }
  .mm-row-lbl {
    font-family: var(--font-group);
    font-weight: 800;
    font-size: .6875rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  /* bold half = current locale, plain half = the tap target */
  .mm-lang {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border-radius: var(--r-pill);
    border: 2px solid var(--line);
    font-family: var(--font-group);
    font-size: .8125rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }
  .mm-lang b { font-weight: 800; color: #1f2c2e; }
  .mm-lang span { font-weight: 700; }
  .mm-lang i { width: 1px; height: 14px; background: var(--line); }
  .mm-lang:active { border-color: var(--ink); }

  .mm-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
  }
  .mm-contacts a {
    font-size: .875rem;
    font-weight: 700;
    color: var(--ink-3);
  }
  .mm-contacts a:active { color: var(--blue); }

  /* rows stagger in top-to-bottom via --i */
  .mobile-menu .mm-link,
  .mobile-menu .mm-foot { opacity: 0; transform: translateY(14px); }
  .mobile-menu.open .mm-link,
  .mobile-menu.open .mm-foot {
    opacity: 1;
    transform: none;
    transition:
      opacity 320ms var(--ease-out) calc(90ms + var(--i, 0) * 45ms),
      transform 380ms var(--ease-out) calc(90ms + var(--i, 0) * 45ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu .mm-link, .mobile-menu .mm-foot { transition: none; }
    .mobile-menu { clip-path: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet { transition: none; }
  }

  @media (max-width: 1180px) {
    /* a tablet on its side still shows the full menu, and 30px links are
       a mouse target, not a finger's — the bar has 68px, use it */
    .gnav-link { padding: 8px 10px; font-size: .875rem; }
    .gnav-lang { height: 40px; }
  }
  @media (max-width: 1000px) {
    .gnav-inner { grid-template-columns: minmax(0, 1fr) auto; }
    .gnav-links { display: none; }
    .gnav-burger { display: grid; }
    /* the sheet covers the page but never the bar: the brand stays put and
       the burger stays where the thumb last touched it, now as the close */
    .gnav { z-index: 60; }
    /* the two controls left in the bar are now tapped, not clicked —
       36px was under the 40px a thumb needs */
    .gnav-lang, .gnav-burger { height: 40px; }
  }
  @media (max-width: 620px) {
    .gnav-brand { gap: 10px; }
    .gnav-eddy { height: 21px; }
    .gnav-mark { height: 21px; }
    .gnav-vline { height: 19px; }
  }
  /* below 430px the global img{max-width:100%} would otherwise squash the group mark instead of shrinking height */
  @media (max-width: 430px) {
    .gnav-inner { gap: 12px; }
    .gnav-brand { gap: 8px; }
    .gnav-eddy { height: 18px; }
    .gnav-mark { height: 18px; }
    .gnav-vline { height: 16px; }
  }
  /* below 340px the product mark is dropped; group mark stays */
  @media (max-width: 340px) {
    .gnav-vline, .gnav-product { display: none; }
  }
</style>
