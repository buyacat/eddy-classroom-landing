---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import WhyUs from '../../components/WhyUs.astro';
import Platform from '../../components/Platform.astro';
import Library3D from '../../components/Library3D.astro';
import LeadForm from '../../components/LeadForm.astro';
import Footer from '../../components/Footer.astro';

const locale = 'en';
---

<Layout locale={locale} path="/en/">
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <WhyUs locale={locale} />
    <Platform locale={locale} />
    <Library3D locale={locale} />
    <LeadForm locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
