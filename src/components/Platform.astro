---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';
import WheelIcon from './WheelIcon.astro';
import PlatformMock from './PlatformMock.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;

const items = tArray<{ icon: string; title: string; text: string; shot_alt?: string; wide?: boolean }>(
  locale,
  'classroom_platform_items'
);

// Windows are drawn stand-ins, not real screenshots (see PlatformMock.astro).
const shots: Record<string, { url: string }> = {
  web: { url: 'classroom.eddygroup.eu/library' },
  session: { url: 'classroom.eddygroup.eu/session' },
  student: { url: 'classroom.eddygroup.eu/quiz' },
  panel: { url: 'classroom.eddygroup.eu/board' },
  analytics: { url: 'classroom.eddygroup.eu/results' }
};

// No hanging 3D objects on this band (see WhyUs for that treatment); only the games card keeps icons, as labeled content.

const blocks: Record<string, string> = {
  student: 'is-yellow',
  virtual: 'is-blue'
};

// games/virtual show a product state instead of a screen crop (in-lesson tools; live roster).
const half = new Set(['games', 'virtual']);

// Wheel icon is custom-drawn (src/assets/icon-src/wheel.svg); clock/megaphone are from the icon pack.
const tools = [
  { key: 'wheel', title: t(locale, 'classroom_hero_wheel_title'), tint: 'is-yellow' },
  { key: 'clock', title: t(locale, 'classroom_hero_timer_title'), tint: 'is-blue' },
  { key: 'megaphone', title: t(locale, 'classroom_hero_noise_title'), tint: 'is-green' }
];

const roster = [
  { ini: 'АК', bg: 'var(--blue)', fg: '#fff' },
  { ini: 'МІ', bg: 'var(--yellow)', fg: '#000' },
  { ini: 'ОП', bg: 'var(--green)', fg: '#000' },
  { ini: 'ДС', bg: 'var(--ink)', fg: '#fff' }
];
---

<section class="band platform" id="platform">
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow">{t(locale, 'classroom_platform_eyebrow')}</span>
      <h2 set:html={t(locale, 'classroom_platform_title')} />
    </div>

    <div class="plat-grid">
      {items.map((it, i) => {
        const shot = shots[it.icon];
        const cls = [
          'card', 'plat-card', 'reveal',
          blocks[it.icon] || '',
          it.wide ? 'is-wide' : '',
          half.has(it.icon) ? 'is-half' : '',
          it.icon === 'analytics' ? 'is-analytics' : ''
        ].filter(Boolean).join(' ');
        return (
          <article class={cls} style={`--i:${i}`}>
            <div class="plat-body">
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>

            {shot && (
              <div class="plat-win">
                <span class="win-bar" aria-hidden="true">
                  <i class="d1"></i><i class="d2"></i><i class="d3"></i>
                  <span class="win-url">{shot.url}</span>
                </span>
                <span class="win-view">
                  <PlatformMock variant={it.icon as 'web' | 'session' | 'student' | 'panel' | 'analytics'} />
                </span>
              </div>
            )}

            {it.icon === 'games' && (
              <ul class="plat-tools" aria-label={it.title}>
                {tools.map((tool) => (
                  <li class={`plat-tool ${tool.tint} is-${tool.key}`}>
                    <span class="tool-ic" aria-hidden="true">
                      {tool.key === 'wheel'
                        ? <WheelIcon />
                        : <img class="obj is-inline" src={withBase(`/assets/icons/${tool.key}.png`)}
                               width="256" height="256" alt="" loading="lazy" decoding="async" />}
                      {tool.key === 'clock' && (
                        <>
                          <i class="buzz buzz-l"></i>
                          <i class="buzz buzz-r"></i>
                        </>
                      )}
                    </span>
                    <span>{tool.title}</span>
                  </li>
                ))}
              </ul>
            )}

            {it.icon === 'virtual' && (
              <div class="plat-roster" aria-hidden="true">
                <span class="avs">
                  {roster.map((r) => (
                    <span style={`background:${r.bg};color:${r.fg}`}>{r.ini}</span>
                  ))}
                </span>
                <span class="txt">
                  <span class="t1">{t(locale, 'classroom_hero_roster_class')}</span>
                  <span class="t2"><b>4</b> {t(locale, 'classroom_platform_virtual_remote')} · <b>22</b> {t(locale, 'classroom_platform_virtual_online')}</span>
                </span>
                <span class="shot-live"><i class="pulse"></i>{t(locale, 'classroom_hero_panel_live')}</span>
              </div>
            )}
          </article>
        );
      })}
    </div>

    {/* Phone pager: only visible below 760px, where the grid becomes a swipe strip */}
    <div class="plat-dots" data-plat-dots>
      {items.map((it, i) => (
        <button class="plat-dot" type="button" data-plat-dot={i} aria-label={it.title}></button>
      ))}
    </div>
  </div>
</section>

<style>
  /* see WhyUs — the band is transparent so the ambient plane shows through */
  .platform::before {
    background:
      /* blue: top-right, echoes the product's own colour */
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .58) at 98% 22%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) var(--amb-fade)),
      /* yellow: bottom-left, under the colour-block cards */
      radial-gradient(var(--amb-r-md) calc(var(--amb-r-md) * .62) at 2% 82%,
        rgba(var(--amb-yellow), var(--amb-2)) 0%,
        rgba(var(--amb-yellow), 0) var(--amb-fade)),
      /* green: wide and weak through the middle, fills the long band's bare centre column */
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .44) at 46% 56%,
        rgba(var(--amb-green), var(--amb-1)) 0%,
        rgba(var(--amb-green), 0) var(--amb-fade));
  }

  /* wider gutter than the shared --gap-card: cards here hold a framed screenshot, which needs more air */
  .plat-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(18px, 1.8vw, 26px);
    margin-top: clamp(40px, 3.6vw, 56px);
  }

  /* extends .card (style.css); padding moves to .plat-body so the browser window below runs edge to edge */
  .plat-card {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .plat-body { padding: clamp(26px, 2.4vw, 34px) var(--pad-card) clamp(20px, 1.9vw, 28px); }
  /* reserves 2 lines so 1- and 2-line titles still align body copy below (UA titles wrap unpredictably) */
  .plat-card:not(.is-wide) h3 { min-height: calc(2 * 1.22em); }

  /* three type tiers rank the cards: screens (26px) > states (22px) > features (19px) */
  .plat-card:not(.is-wide):not(.is-half) h3 { font-size: clamp(1.0625rem, 1rem + .3vw, 1.1875rem); }
  .plat-card:not(.is-wide):not(.is-half) p { font-size: .875rem; }

  /* the one blue card carries the page's only coloured shadow at rest */
  .plat-card.is-blue { box-shadow: var(--e-blue); }
  .plat-card.is-blue:hover { box-shadow: 0 18px 40px -14px rgba(64, 80, 255, .6); }

  /* ---- wide cards: the two full product-screen cards, paired at half width each ---- */
  .plat-card.is-wide { grid-column: span 3; }
  .plat-card.is-wide .plat-body { flex: none; }
  .plat-card.is-wide h3 { font-size: clamp(1.25rem, 1.05rem + .55vw, 1.625rem); }
  .plat-card.is-wide p { font-size: .9375rem; max-width: 46ch; }

  /* one fixed window height across every card (wide included) so all five screens read as one product */
  .plat-win {
    --win-inset: clamp(18px, 1.7vw, 28px);
    margin: auto var(--win-inset) var(--win-inset);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(15, 18, 45, .05), 0 20px 38px -20px rgba(15, 18, 45, .42);
    overflow: hidden;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #f1f2f7;
    border-bottom: 1px solid rgba(15, 18, 45, .07);
  }
  .win-bar i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .win-bar .d1 { background: #ff5f57; }
  .win-bar .d2 { background: #febc2e; }
  .win-bar .d3 { background: #28c840; }
  .win-url {
    flex: 1;
    min-width: 0;
    margin-left: 8px;
    height: 18px;
    padding: 0 9px;
    border-radius: var(--r-pill);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(15, 18, 45, .08);
    display: flex;
    align-items: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
  }
  /* height kept per-card so the window ratio stays ~2:1 or wider, never a square */
  .win-view {
    display: block;
    height: 152px;
    overflow: hidden;
    background: #fff;
  }
  .plat-card.is-wide .win-view { height: clamp(172px, 14vw, 204px); }

  /* ---- half cards: the two that show a product state instead of a crop ---- */
  .plat-card.is-half { grid-column: span 3; }
  .plat-card.is-half .plat-body { flex: 1; }
  .plat-card.is-half p { max-width: 44ch; }

  /* each tool tinted separately; the label is what makes this read as UI, not just icons */
  .plat-tools {
    list-style: none;
    margin: 0;
    padding: 0 var(--pad-card) var(--pad-card);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .plat-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 8px 12px;
    border-radius: var(--r-md);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: .8125rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .plat-tool.is-yellow { background: var(--yellow-soft); }
  .plat-tool.is-blue { background: var(--blue-soft); }
  .plat-tool.is-green { background: var(--green-soft); }

  /* card hover lifts all three tools ("pressable"); each tool's own animation only plays on its own hover */
  .plat-tool {
    transition: transform var(--t-hover) var(--ease-out),
                box-shadow var(--t-hover) var(--ease-out);
  }
  .plat-tool:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(31, 44, 46, .09); }

  .plat-tool .tool-ic {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
  }
  .plat-tool .obj {
    width: 52px;
    height: 52px;
    /* the wheel is an inline <svg> now, so it needs the box stated twice */
    flex: none;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .14));
    transition: transform var(--t-card) var(--ease-spring);
  }
  /* the card-level hover lifts all three objects together — the shared
     "these are pressable" cue — while the specific animation below still
     only fires on the one tile actually under the pointer */
  .plat-card:hover .plat-tool .obj { transform: translateY(-3px); }

  /* wheel spin animation lives in WheelIcon.astro (only the wedges turn) */

  /* tremble kept small/fast (2.5deg, 14Hz) so it reads as a buzz, not a pendulum swing */
  @keyframes tool-tremble {
    0%, 100% { transform: translate(0, -3px) rotate(0deg); }
    20%      { transform: translate(-.8px, -3px) rotate(-2.5deg); }
    40%      { transform: translate(.8px, -3.4px) rotate(2.5deg); }
    60%      { transform: translate(-.7px, -2.8px) rotate(-2deg); }
    80%      { transform: translate(.7px, -3.2px) rotate(1.8deg); }
  }
  /* two 4.5-cycle rings (~0.5s each) with a ~0.15s pause between, instead of one continuous shake */
  .plat-card .plat-tool.is-clock:hover .obj {
    animation: tool-tremble .11s linear 4.5,
               tool-tremble .11s linear 4.5 .65s;
  }

  /* positioned off the bells (not the clock centre) so the arcs read as leaving the bell */
  .plat-tool.is-clock .buzz {
    position: absolute;
    top: -5px;
    width: 15px;
    height: 15px;
    border: 2.5px solid transparent;
    border-top-color: var(--blue);
    border-radius: 50%;
    opacity: 0;
  }
  .plat-tool.is-clock .buzz::before {
    content: '';
    position: absolute;
    inset: 3.5px;
    border: 2.5px solid transparent;
    border-top-color: var(--blue);
    border-radius: 50%;
  }
  .plat-tool.is-clock .buzz-l { left: -7px; rotate: -48deg; }
  .plat-tool.is-clock .buzz-r { right: -7px; rotate: 48deg; }
  @keyframes tool-buzz {
    0%   { opacity: 0; scale: .7; }
    35%  { opacity: 1; scale: 1; }
    100% { opacity: 0; scale: 1.25; }
  }
  /* timed to the same two-ring shape as the tremble above (second pair at .65s) */
  .plat-tool.is-clock:hover .buzz-l {
    animation: tool-buzz .4s ease-out,
               tool-buzz .4s ease-out .65s;
  }
  .plat-tool.is-clock:hover .buzz-r {
    animation: tool-buzz .4s ease-out .2s,
               tool-buzz .4s ease-out .85s;
  }

  /* noise meter: arcs leaving the horn. Two of them, half a beat apart, so
     it reads as sound coming out rather than one ring pulsing. */
  .plat-tool.is-megaphone .tool-ic::before,
  .plat-tool.is-megaphone .tool-ic::after {
    content: '';
    position: absolute;
    /* tipped to match the horn's opening (up-right); square to the tile it reads as a loading spinner */
    top: 34%;
    right: -9px;
    width: 20px;
    height: 20px;
    border: 3px solid transparent;
    border-right-color: var(--green-deep);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(-50%) rotate(-22deg) scale(.4);
  }
  @keyframes tool-wave {
    0%   { opacity: 0; transform: translateY(-50%) rotate(-22deg) scale(.4); }
    20%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-50%) rotate(-22deg) scale(1.5); }
  }
  .plat-card .plat-tool.is-megaphone:hover .obj { transform: translate(2px, -3px); }
  .plat-tool.is-megaphone:hover .tool-ic::before { animation: tool-wave 1.15s ease-out 2; }
  .plat-tool.is-megaphone:hover .tool-ic::after { animation: tool-wave 1.15s ease-out .38s 2; }

  @media (prefers-reduced-motion: reduce) {
    .plat-card .plat-tool.is-clock:hover .obj { animation: none; }
    .plat-tool.is-clock:hover .buzz-l,
    .plat-tool.is-clock:hover .buzz-r,
    .plat-tool.is-megaphone:hover .tool-ic::before,
    .plat-tool.is-megaphone:hover .tool-ic::after { animation: none; opacity: 0; }
  }

  /* a roster with a LIVE chip: the hero's badge grammar, sitting inside the
     blue card as a white panel */
  .plat-roster {
    margin: 0 var(--pad-card) var(--pad-card);
    padding: 12px 14px 12px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--e2);
  }
  .plat-roster .avs { display: flex; flex: none; }
  .plat-roster .avs span {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 2.5px solid #fff;
    margin-left: -10px;
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-size: 11px; font-weight: 800;
  }
  .plat-roster .avs span:first-child { margin-left: 0; }
  .plat-roster .txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .plat-roster .t1 { font-family: var(--font-display); font-weight: 800; font-size: 13.5px; color: var(--ink); }
  .plat-roster .t2 { font-size: 11.5px; font-weight: 600; color: var(--ink-3); white-space: nowrap; }
  .plat-roster .t2 b { color: var(--ink); font-variant-numeric: tabular-nums; }
  /* the LIVE pill itself is the shared `.shot-live` from style.css; the
     roster only pins it to the right and gives it a pixel more height */
  .plat-roster .shot-live { margin-left: auto; flex: none; padding-block: 4px; }

  @media (max-width: 1000px) {
    .plat-grid { grid-template-columns: repeat(4, 1fr); }
    .plat-card { grid-column: span 2; }
    /* below the desktop grid the screenshots need the whole row to stay
       legible; everything else pairs up */
    .plat-card.is-wide { grid-column: span 4; }
    .plat-card.is-half { grid-column: span 2; }
    /* five cards in pairs leave a hole; the analytics window is a wide
       chart, so it is the one that takes a full row without stretching */
    .plat-card.is-analytics { grid-column: span 4; }
    .plat-card.is-analytics .win-view { height: 176px; }
    /* the half card is 346px here and the roster's avatars and LIVE pill
       leave the text 95px — "4 дистанційно · 22 на зв'язку" on one line
       was cut off after the 22 */
    .plat-roster .t2 { white-space: normal; }
  }
  /* the pager is a phone control; above 760px the grid is a grid */
  .plat-dots { display: none; }

  /* ---- phones: swipe strip (scroll-snap) instead of stacked full-width cards ----
     Negative margin + matching padding bleeds the strip to both viewport edges so the next card peeks in. */
  @media (max-width: 760px) {
    .plat-grid {
      display: flex;
      grid-template-columns: none;
      gap: 12px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 10px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .plat-grid::-webkit-scrollbar { display: none; }

    .plat-card,
    .plat-card.is-wide,
    .plat-card.is-half,
    .plat-card.is-analytics {
      grid-column: auto;
      flex: 0 0 min(86%, 360px);
      scroll-snap-align: start;
    }
    /* disable .reveal's transform here: an off-screen card stuck 20px low would wobble the strip's height */
    .plat-grid .reveal { transform: none; }
    /* every card the same height, so the pager underneath does not jump */
    .plat-card:not(.is-wide) h3 { min-height: 0; }
    .win-view, .plat-card.is-wide .win-view { height: 168px; }
    .plat-card.is-analytics .win-view img { width: var(--zoom); }
    .plat-tool { padding: 12px 6px 10px; font-size: .75rem; }
    .plat-tool .obj, .plat-tool .tool-ic { width: 44px; height: 44px; }
    .plat-roster { gap: 10px; padding: 10px 12px 10px 10px; }
    .plat-roster .t2 { white-space: normal; }

    .plat-dots {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 4px;
    }
    /* 26px tap target around a 7px visible dot */
    .plat-dot {
      width: 26px; height: 26px;
      border: 0;
      padding: 0;
      background: none;
      cursor: pointer;
      display: grid;
      place-items: center;
    }
    .plat-dot::before {
      content: '';
      width: 7px; height: 7px;
      border-radius: var(--r-pill);
      background: var(--line);
      transition: background 160ms linear, width 240ms var(--ease-spring);
    }
    .plat-dot.is-active::before { width: 20px; background: var(--ink); }
    .plat-dot:focus { outline: none; }
    .plat-dot:focus-visible { outline: none; box-shadow: var(--focus-ring); border-radius: var(--r-pill); }
  }
</style>

<script>
  // Syncs the pager dots with the scroll-snap carousel below 760px (no-op on desktop).
  // Active card = nearest to strip centre, not computed from card width (cards are min(86%, 360px), variable per phone).
  const strip = document.querySelector<HTMLElement>('.plat-grid');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-plat-dot]'));
  const cards = strip ? Array.from(strip.children) as HTMLElement[] : [];

  if (strip && dots.length && cards.length) {
    let raf = 0;

    function active() {
      const mid = strip!.scrollLeft + strip!.clientWidth / 2;
      let best = 0;
      let bestGap = Infinity;
      cards.forEach((c, i) => {
        const gap = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid);
        if (gap < bestGap) { bestGap = gap; best = i; }
      });
      return best;
    }

    function sync() {
      const i = active();
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
    }

    strip.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; sync(); });
    }, { passive: true });

    dots.forEach((d, i) => {
      d.addEventListener('click', () => {
        const card = cards[i];
        if (!card) return;
        const pad = parseFloat(getComputedStyle(strip!).paddingLeft) || 0;
        strip!.scrollTo({
          left: card.offsetLeft - pad,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      });
    });

    sync();
    window.addEventListener('resize', sync);
  }
</script>
