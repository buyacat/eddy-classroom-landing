---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props { locale: Locale }
const { locale } = Astro.props;

const items = tArray<{ icon: string; title: string; text: string; shot_alt?: string; wide?: boolean }>(
  locale,
  'classroom_platform_items'
);

/*
 * This is the band that has to prove the feature list is real, so five of
 * the seven cards carry an actual screen of the shipping app. Alt text
 * comes from the locale file (`shot_alt`), so /en/ does not get Ukrainian
 * alts.
 */
/*
 * Every screenshot in this band sits in the same browser window: chrome on
 * top, the screen under it, the frame running off the bottom edge of its
 * card. Cropped screenshots bleeding straight into a rounded corner read
 * as a broken image; the same crop inside a window reads as a product you
 * are looking at. `zoom` is the displayed width of the screen inside that
 * window — 100% shows the whole page, more than that is a crop, and each
 * screen has its own density, so a single value would leave some
 * unreadably small. `pan` slides the viewport down the page when the part
 * worth showing is not the very top.
 */
const shots: Record<string, { src: string; w: number; h: number; zoom: string; url: string; pan?: string }> = {
  web: { src: withBase('/assets/shots/shot-library.jpg'), w: 1400, h: 711, zoom: '100%', url: 'app.eddy.school/library' },
  /* The one screen that shows the product doing its whole job at once: the
     class answering on the right, the teacher's live table on the left. */
  session: { src: withBase('/assets/shots/shot-session.jpg'), w: 1430, h: 824, zoom: '100%', url: 'app.eddy.school/session' },
  student: { src: withBase('/assets/shots/shot-quiz.png'), w: 1100, h: 646, zoom: '156%', url: 'app.eddy.school/quiz' },
  panel: { src: withBase('/assets/shots/shot-pins.jpg'), w: 820, h: 615, zoom: '118%', url: 'app.eddy.school/board', pan: '-46px' },
  analytics: { src: withBase('/assets/shots/shot-results.jpg'), w: 1400, h: 390, zoom: '168%', url: 'app.eddy.school/results' }
};

/* Two sizes of object only: 96px on cards that carry a screenshot, 128px on
   the two half-width cards that carry a live mini-UI instead. Every object
   in this band is a colour object: the grey ones (contract, pen, search)
   sank into the white cards and read as switched-off. `document` repeats a
   WhyUs object one band up, which is the lesser evil — the blue folder is
   what a teacher's workspace of courses looks like. `location` is the pin
   the whiteboard card's own screenshot is covered in. */
const objects: Record<string, string> = {
  web: 'document',
  session: 'apple',   // the band already has a medal on analytics; two awards read as one idea
  student: 'key',
  panel: 'location',
  analytics: 'medal',
  games: 'gift',
  virtual: 'chat'
};

/* One colour block per row, on a diagonal: yellow top-left of the second
   row, blue bottom-right of the third. Blue is the product's own colour and
   it used to belong to the course card — the section keeps it on the card
   that shows a LIVE state. */
const blocks: Record<string, string> = {
  student: 'is-yellow',
  virtual: 'is-blue'
};

/* `games` and `virtual` have no shipping screen worth cropping. Instead of a
   colour block and an oversized object they get a state of the product: the
   three in-lesson tools the hero already floats next to the globe, and a
   roster with a LIVE chip — the same grammar as the hero's roster badge. */
const half = new Set(['games', 'virtual']);

const tools = [
  { key: 'coin', title: t(locale, 'classroom_hero_wheel_title'), tint: 'is-yellow' },
  { key: 'clock', title: t(locale, 'classroom_hero_timer_title'), tint: 'is-blue' },
  { key: 'music', title: t(locale, 'classroom_hero_noise_title'), tint: 'is-green' }
];

const roster = [
  { ini: 'АК', bg: 'var(--blue)', fg: '#fff' },
  { ini: 'МІ', bg: 'var(--yellow)', fg: '#000' },
  { ini: 'ОП', bg: 'var(--green)', fg: '#000' },
  { ini: 'ДС', bg: 'var(--ink)', fg: '#fff' }
];
---

<section class="band platform" id="platform">
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow">{t(locale, 'classroom_platform_eyebrow')}</span>
      <h2 set:html={t(locale, 'classroom_platform_title')} />
    </div>

    <div class="plat-grid">
      {items.map((it, i) => {
        const shot = shots[it.icon];
        const cls = [
          'plat-card', 'reveal',
          blocks[it.icon] || '',
          it.wide ? 'is-wide' : '',
          half.has(it.icon) ? 'is-half' : '',
          it.icon === 'analytics' ? 'is-analytics' : ''
        ].filter(Boolean).join(' ');
        return (
          <article class={cls} style={`--i:${i}`}>
            <div class="plat-body">
              <img class="obj" src={withBase(`/assets/icons/${objects[it.icon] || 'book'}.png`)}
                   width="256" height="256" alt="" loading="lazy" decoding="async" />
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>

            {shot && (
              <div class="plat-win" style={`--zoom:${shot.zoom};--pan:${shot.pan ?? '0px'}`}>
                <span class="win-bar" aria-hidden="true">
                  <i class="d1"></i><i class="d2"></i><i class="d3"></i>
                  <span class="win-url">{shot.url}</span>
                </span>
                <span class="win-view">
                  <img src={shot.src} width={shot.w} height={shot.h} alt={it.shot_alt ?? it.title}
                       loading="lazy" decoding="async" />
                </span>
              </div>
            )}

            {it.icon === 'games' && (
              <ul class="plat-tools" aria-label={it.title}>
                {tools.map((tool) => (
                  <li class={`plat-tool ${tool.tint}`}>
                    <img class="obj is-inline" src={withBase(`/assets/icons/${tool.key}.png`)}
                         width="256" height="256" alt="" loading="lazy" decoding="async" />
                    <span>{tool.title}</span>
                  </li>
                ))}
              </ul>
            )}

            {it.icon === 'virtual' && (
              <div class="plat-roster" aria-hidden="true">
                <span class="avs">
                  {roster.map((r) => (
                    <span style={`background:${r.bg};color:${r.fg}`}>{r.ini}</span>
                  ))}
                </span>
                <span class="txt">
                  <span class="t1">{t(locale, 'classroom_hero_roster_class')}</span>
                  <span class="t2"><b>4</b> {t(locale, 'classroom_platform_virtual_remote')} · <b>22</b> {t(locale, 'classroom_platform_virtual_online')}</span>
                </span>
                <span class="shot-live"><i class="pulse"></i>{t(locale, 'classroom_hero_panel_live')}</span>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* see WhyUs — the band is transparent so the ambient plane shows through */
  .platform::before {
    background:
      /* Blue is the product's own colour: the shot-bar dot, the library
         count, the CTA block. This is the band that has to prove the feature
         list is real, so this is the band lit in blue. */
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .58) at 98% 22%,
        rgba(var(--amb-blue), var(--amb-2)) 0%,
        rgba(var(--amb-blue), 0) var(--amb-fade)),
      /* Yellow low and left, under the colour-block cards, so the grid's own
         yellow has somewhere to have come from. */
      radial-gradient(var(--amb-r-md) calc(var(--amb-r-md) * .62) at 2% 82%,
        rgba(var(--amb-yellow), var(--amb-2)) 0%,
        rgba(var(--amb-yellow), 0) var(--amb-fade)),
      /* A wide, weak green through the middle. The band is long and its
         centre column was the one stretch of bare canvas on the page; this
         fills it without putting a second colour event next to the blue. */
      radial-gradient(var(--amb-r-xl) calc(var(--amb-r-xl) * .44) at 46% 56%,
        rgba(var(--amb-green), var(--amb-1)) 0%,
        rgba(var(--amb-green), 0) var(--amb-fade));
  }

  .plat-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gap-card);
    margin-top: clamp(52px, 5vw, 76px);
  }

  .plat-card {
    grid-column: span 2;
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: var(--r-xl);
    --obj: 96px;
    transition: transform var(--t-hover) var(--ease-out), box-shadow var(--t-hover) var(--ease-out);
  }
  .plat-card:hover { transform: translateY(-4px); box-shadow: var(--e3); }

  .plat-body { padding: var(--pad-card) var(--pad-card) clamp(18px, 1.7vw, 26px); }
  .plat-card h3 { margin-bottom: 10px; }
  /* a one- and a two-line title in the same row must still align their
     body copy — Ukrainian card titles wrap unpredictably (same as WhyUs) */
  .plat-card:not(.is-wide) h3 { min-height: calc(2 * 1.22em); }
  .plat-card p { font-size: .9375rem; line-height: 1.55; color: var(--ink-3); margin: 0; }

  .plat-card.is-yellow { background: var(--yellow); }
  .plat-card.is-yellow p { color: rgba(0, 0, 0, .68); }
  .plat-card.is-blue { background: var(--blue); box-shadow: var(--e-blue); }
  .plat-card.is-blue h3 { color: #fff; }
  .plat-card.is-blue p { color: var(--ink-inv-2); }
  .plat-card.is-blue:hover { box-shadow: 0 18px 40px -14px rgba(64, 80, 255, .6); }

  /* ---- wide cards: the two that carry a full product screen ----
     They used to take a whole row each, which pushed the band past two
     viewport heights before the small cards even appeared. Paired at half
     width they read as one "here is the product" row, and the band lands
     in three rows: 2 screens / 3 features / 2 states. */
  .plat-card.is-wide { grid-column: span 3; --obj: 112px; }
  .plat-card.is-wide .plat-body { flex: none; }
  .plat-card.is-wide h3 { font-size: clamp(1.25rem, 1.05rem + .55vw, 1.625rem); }
  .plat-card.is-wide p { font-size: .9375rem; max-width: 46ch; }

  /* A browser window resting in the bottom of the card: chrome on top, the
     screen under it, and a real bottom edge — a window that ran off the
     card looked like a screenshot someone forgot to finish cropping. One
     viewport height for every window in the band, wide cards included, so
     five different screens read as five views of one product. */
  .plat-win {
    --win-inset: clamp(18px, 1.7vw, 28px);
    margin: auto var(--win-inset) var(--win-inset);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(15, 18, 45, .05), 0 20px 38px -20px rgba(15, 18, 45, .42);
    overflow: hidden;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #f1f2f7;
    border-bottom: 1px solid rgba(15, 18, 45, .07);
  }
  .win-bar i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .win-bar .d1 { background: #ff5f57; }
  .win-bar .d2 { background: #febc2e; }
  .win-bar .d3 { background: #28c840; }
  .win-url {
    flex: 1;
    min-width: 0;
    margin-left: 8px;
    height: 18px;
    padding: 0 9px;
    border-radius: var(--r-pill);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(15, 18, 45, .08);
    display: flex;
    align-items: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
  }
  /* A browser viewport is a wide letterbox, never a square. Height is set
     per card width so the ratio stays roughly 2:1 or wider — at 212px the
     narrow cards were showing a window shape no laptop has. */
  .win-view {
    display: block;
    height: 152px;
    overflow: hidden;
    background: #fff;
  }
  .plat-card.is-wide .win-view { height: clamp(172px, 14vw, 204px); }
  /* `cover` is what keeps the window a window: a screen shorter than the
     viewport would otherwise leave a white band under it, which reads as a
     rendering bug rather than as a page you have scrolled to the end of */
  .win-view img {
    display: block;
    width: var(--zoom, 100%);
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transform: translateY(var(--pan, 0px));
    transition: transform var(--t-card) var(--ease-out);
  }
  /* on hover the window scrolls a little further down the page — the same
     "there is more of this" gesture the crops make when they scale */
  .plat-card:hover .win-view img { transform: translateY(calc(var(--pan, 0px) - 14px)); }

  /* ---- half cards: the two that show a product state instead of a crop ---- */
  .plat-card.is-half { grid-column: span 3; --obj: 128px; }
  .plat-card.is-half .plat-body { flex: 1; }
  .plat-card.is-half p { max-width: 44ch; }

  /* three in-lesson tools, each on its own soft tint — a tile row, not a
     row of icons: the label is what makes it read as UI */
  .plat-tools {
    list-style: none;
    margin: 0;
    padding: 0 var(--pad-card) var(--pad-card);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .plat-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 8px 12px;
    border-radius: var(--r-md);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: .8125rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .plat-tool.is-yellow { background: var(--yellow-soft); }
  .plat-tool.is-blue { background: var(--blue-soft); }
  .plat-tool.is-green { background: var(--green-soft); }
  .plat-tool .obj { width: 52px; height: 52px; filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .14)); }
  /* the tools take turns lifting on hover — same spring as the card objects,
     staggered so the row reads as three things, not one image */
  .plat-card:hover .plat-tool:nth-child(1) .obj { transform: translateY(-4px) rotate(-6deg); }
  .plat-card:hover .plat-tool:nth-child(2) .obj { transform: translateY(-4px) rotate(4deg); transition-delay: 50ms; }
  .plat-card:hover .plat-tool:nth-child(3) .obj { transform: translateY(-4px) rotate(-4deg); transition-delay: 100ms; }

  /* a roster with a LIVE chip: the hero's badge grammar, sitting inside the
     blue card as a white panel */
  .plat-roster {
    margin: 0 var(--pad-card) var(--pad-card);
    padding: 12px 14px 12px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border-radius: var(--r-lg);
    box-shadow: var(--e2);
  }
  .plat-roster .avs { display: flex; flex: none; }
  .plat-roster .avs span {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 2.5px solid #fff;
    margin-left: -10px;
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-size: 11px; font-weight: 800;
  }
  .plat-roster .avs span:first-child { margin-left: 0; }
  .plat-roster .txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .plat-roster .t1 { font-family: var(--font-display); font-weight: 800; font-size: 13.5px; color: var(--ink); }
  .plat-roster .t2 { font-size: 11.5px; font-weight: 600; color: var(--ink-3); white-space: nowrap; }
  .plat-roster .t2 b { color: var(--ink); font-variant-numeric: tabular-nums; }
  /* the LIVE pill is defined under `.shot-bar` in style.css, so it is
     restated here for the roster panel */
  .plat-roster .shot-live {
    margin-left: auto; flex: none;
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--green); color: var(--ink);
    border-radius: var(--r-pill); padding: 4px 11px;
    font-size: .6875rem; font-weight: 800; letter-spacing: .05em;
  }
  .plat-roster .shot-live i { width: 6px; height: 6px; border-radius: 50%; background: var(--ink); position: relative; }

  @media (max-width: 1000px) {
    .plat-grid { grid-template-columns: repeat(4, 1fr); }
    .plat-card { grid-column: span 2; }
    /* below the desktop grid the screenshots need the whole row to stay
       legible; everything else pairs up */
    .plat-card.is-wide { grid-column: span 4; }
    .plat-card.is-half { grid-column: span 2; }
    /* five cards in pairs leave a hole; the analytics screen is a wide
       table, so it is the one that takes a full row without stretching */
    .plat-card.is-analytics { grid-column: span 4; }
    /* `--zoom` is an inline style on the window, so it is overridden on the
       image itself, not on the custom property */
    .plat-card.is-analytics .win-view { height: 176px; }
    .plat-card.is-analytics .win-view img { width: 112%; }
  }
  @media (max-width: 760px) {
    .plat-grid { grid-template-columns: 1fr; }
    .plat-card, .plat-card.is-wide, .plat-card.is-half, .plat-card.is-analytics { grid-column: span 1; }
    .plat-card:not(.is-wide) h3 { min-height: 0; }
    .plat-card.is-wide { --obj: 112px; }
    .plat-card.is-wide .plat-body { padding-right: var(--pad-card); }
    .win-view, .plat-card.is-wide .win-view { height: 168px; }
    .plat-card.is-analytics .win-view img { width: var(--zoom); }
    .plat-card.is-half { --obj: 112px; }
    .plat-tool { padding: 12px 6px 10px; font-size: .75rem; }
    .plat-tool .obj { width: 44px; height: 44px; }
    .plat-roster { gap: 10px; padding: 10px 12px 10px 10px; }
    .plat-roster .t2 { white-space: normal; }
  }
</style>
